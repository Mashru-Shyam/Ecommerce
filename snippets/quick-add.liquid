{%- doc -%}
  Renders a quick add component.

  @param {object} product - The product object
  @param {string} section_id - The section ID
  @param {object} [block] - The block object
{%- enddoc -%}

{% liquid
  assign product_form_id = 'QuickAdd-ProductForm-' | append: product.id | append: '-' | append: block.id
  assign add_to_cart_text = 'actions.add_to_cart' | t
  # Logic to determine which variant to use (matching swatch selection logic from product-card)
  assign variant = product.selected_or_first_available_variant
  assign cart_variant_quantity = cart | item_count_for_variant: variant.id

  assign uses_selling_plans = false
  if product.requires_selling_plan or product.selling_plan_groups.size > 0
    assign uses_selling_plans = true
  endif

  if variant.available
    assign can_add_to_cart = true
  else
    assign can_add_to_cart = false
  endif

  # Product card actions add the currently selected variant directly.
  assign initial_button = 'add'
  assign render_add = true
  assign render_choose = false

%}

{% render 'fly-to-cart-styles' %}

{% comment %}
  The card form adds the currently selected variant directly. Card navigation opens
  the quick-add dialog for shoppers who want to change options.
{% endcomment %}
<quick-add-component
  class="quick-add custom-color-quick-add"
  ref="quickAdd"
  data-product-title="{{ product.title }}"
  data-product-id="{{ product.id }}"
  data-quick-add-button="{{ initial_button }}"
  data-product-options-count="{{ product.options.size }}"
  data-uses-selling-plans="{{ uses_selling_plans }}"
  data-renders-both-buttons="{% if render_add and render_choose %}true{% endif %}"
  data-in-cart="{% if cart_variant_quantity > 0 %}true{% else %}false{% endif %}"
  data-cart-variant-id="{{ variant.id }}"
  data-cart-quantity="{{ cart_variant_quantity }}"
  data-product-url="{{ product.url }}"
>
  {% if render_add %}
    <product-form-component
      data-section-id="{{ section_id }}"
      data-product-id="{{ product.id }}"
      data-cart-unit-price="{{ variant.price }}"
      on:submit="/handleSubmit"
      class="quick-add__product-form-component"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ variant.id }}"
          {% if variant.available == false %}
            disabled
          {% endif %}
        >
        <input
          type="hidden"
          name="quantity"
          value="{% if variant.quantity_rule.min %}{{ variant.quantity_rule.min }}{% else %}1{% endif %}"
        >
        {% render 'add-to-cart-button',
          add_to_cart_text: add_to_cart_text,
          class: 'quick-add__button quick-add__button--add add-to-cart-button',
          can_add_to_cart: can_add_to_cart,
          show_icon: true,
          product: product
        %}
      {%- endform -%}
    </product-form-component>
  {% endif %}

  <button type="button" class="quick-add__modal-trigger" on:click="quick-add-component/handleClick" hidden aria-hidden="true" tabindex="-1"></button>

  <div class="quick-add__cart-controls" {% if cart_variant_quantity == 0 %}hidden{% endif %}>
    <button class="quick-add__cart-step" type="button" aria-label="{{ 'accessibility.decrease_quantity' | t }}" on:click="quick-add-component/decreaseCartQuantity">−</button>
    <span class="quick-add__cart-count" aria-live="polite">{{ cart_variant_quantity }}</span>
    <button class="quick-add__cart-step" type="button" aria-label="{{ 'accessibility.increase_quantity' | t }}" on:click="quick-add-component/increaseCartQuantity">+</button>
  </div>

</quick-add-component>

{% render 'add-to-cart-button-styles' %}
{% render 'checkbox-styles' %}
{% render 'text-block-styles' %}
{% render 'price-styles' %}
{% render 'variant-picker-styles' %}
{% render 'quick-add-styles' %}
{% render 'video-background-styles' %}
{% render 'video-placeholder-styles' %}
{% render 'deferred-media-product-model-styles' %}
