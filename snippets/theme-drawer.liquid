{% doc %}
  Theme Drawer Infrastructure

  Loads the theme-drawer Web Component and provides global drawer
  coordination: session restore, page-wrapper squeeze, and state persistence.
  Rendered once from layout/theme.liquid.

  Individual drawer snippets (e.g. chat-drawer) render their own
  <theme-drawer> elements. Shared structural CSS is inlined here.

  @example
  {% render 'theme-drawer' %}
{% enddoc %}

{% render 'theme-drawer-styles' %}

<script
  type="module"
  src="{{ 'theme-drawer.js' | asset_url }}"
  fetchpriority="low"
></script>

<script>
  /* Runs synchronously during HTML parsing — opens the correct drawer on first
     paint if navigation state was saved, so it renders with the rest of the page. */
  (function () {
    var drawerIds = (sessionStorage.getItem('theme-drawer-open') || '').split(',').filter(Boolean);
    if (!drawerIds.length) return;

    // Only restore on wide viewports. Standard drawers use squeeze mode there;
    // explicitly modal drawers (such as the cart) restore as modal overlays.
    // On narrow viewports, let drawers start closed after navigation rather
    // than re-opening a fullscreen panel the user may have left behind.
    if (!window.matchMedia('(min-width: 990px)').matches) return;

    var dialogs = [];
    var shouldSqueeze = false;
    for (var i = 0; i < drawerIds.length; i++) {
      var drawer = document.getElementById(drawerIds[i]);
      if (!drawer) continue;

      drawer.setAttribute('open', '');

      // Set [open] directly for standard drawers so the CSS slide-in applies
      // without triggering the browser's dialog focusing steps. Explicitly
      // modal drawers use showModal() so their backdrops and focus behavior work.
      // The instant class suppresses the slide-in transition for the initial restore.
      // Set --drawer-stack-order so z-index layering matches the original order.
      drawer.style.setProperty('--drawer-stack-order', String(i + 1));

      var dialog = drawer.querySelector('dialog');
      if (dialog) {
        if (drawer.hasAttribute('modal') && typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
          shouldSqueeze = true;
        }
        dialog.classList.add('theme-drawer__dialog-instant');
        dialogs.push(dialog);
      }

      // Let each drawer type handle its own restore (e.g. shopify-chat mode).
      // Synchronous dispatch — listeners attached during earlier parsing run immediately.
      drawer.dispatchEvent(new CustomEvent('theme-drawer:restoring'));
    }

    // Apply squeeze immediately, bypassing the margin transition.
    // Only squeeze if at least one drawer was actually restored — saved
    // drawer IDs may not exist on every page (e.g. cart-drawer on /cart).
    var pageWrapper = document.querySelector('.page-wrapper');
    if (pageWrapper && shouldSqueeze) {
      pageWrapper.style.transition = 'none';
      pageWrapper.classList.add('page-wrapper--drawer-open');
    }

    // Re-enable transitions after one paint so the instant state is rendered first.
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        if (pageWrapper) pageWrapper.style.transition = '';
        for (var j = 0; j < dialogs.length; j++) {
          dialogs[j].classList.remove('theme-drawer__dialog-instant');
        }
      });
    });
  })();
</script>

<script
  type="module"
>
  const pageWrapper = document.querySelector('.page-wrapper');
  const squeezeQuery = window.matchMedia('(min-width: 990px)');

  // ── Squeeze coordination ──
  // Listens to all drawers. Only squeezes on wide viewports.
  document.addEventListener('theme-drawer:open', (event) => {
    const drawer = event.target.closest('theme-drawer');
    if (squeezeQuery.matches && !drawer?.hasAttribute('modal')) {
      pageWrapper?.classList.add('page-wrapper--drawer-open');
    }
  });

  document.addEventListener('theme-drawer:close', () => {
    const openDrawer = document.querySelector('theme-drawer[open]:not([modal])');
    if (!openDrawer) {
      pageWrapper?.classList.remove('page-wrapper--drawer-open');
    }
  });

  squeezeQuery.addEventListener('change', () => {
    const openDrawer = document.querySelector('theme-drawer[open]');
    pageWrapper?.classList.toggle('page-wrapper--drawer-open', Boolean(openDrawer) && squeezeQuery.matches);
  });

  // ── State persistence ──
  // Store open drawer IDs sorted by their visual stack order so
  // the restore script can recreate the same z-index layering.
  function persistDrawerState() {
    const openDrawers = Array.from(document.querySelectorAll('theme-drawer[open]:not([no-persist])'));
    if (!openDrawers.length) {
      sessionStorage.removeItem('theme-drawer-open');
      return;
    }

    openDrawers.sort((a, b) => {
      const orderA = Number(a.style.getPropertyValue('--drawer-stack-order') || 0);
      const orderB = Number(b.style.getPropertyValue('--drawer-stack-order') || 0);
      return orderA - orderB;
    });

    sessionStorage.setItem('theme-drawer-open', openDrawers.map((d) => d.id).join(','));
  }

  document.addEventListener('theme-drawer:open', persistDrawerState);
  document.addEventListener('theme-drawer:close', persistDrawerState);
</script>
