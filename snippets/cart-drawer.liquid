{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <h2
        class="theme-drawer__title h4"
        id="cart-drawer-heading"
      >
        {{ 'content.your_cart_is_empty' | t }}
      </h2>

      <div class="cart-drawer__items">
        {% render 'cart-products', force_empty: true, context: 'drawer' %}
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    modal
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog cart-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span
                class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
                aria-hidden="true"
                {% if cart.item_count <= 99 %}
                  data-maintain-ratio
                {% endif %}
              >
                {{- cart.item_count -}}
              </span>
              {% if cart.item_count > 0 %}
                <span class="visually-hidden">
                  {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
                </span>
              {% endif %}
            {% endcapture %}
            {% assign cart_drawer_title = 'Your cart' %}
            {% capture cart_clear_action %}
              <form action="{{ routes.cart_clear_url }}" method="post" class="cart-drawer__clear-form">
                <button type="submit" class="cart-drawer__clear">Clear cart</button>
              </form>
            {% endcapture %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html,
              trailing_action: cart_clear_action
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                {%- assign free_delivery_goal = settings.cart_free_delivery_goal | times: 100 -%}
                {%- if free_delivery_goal > 0 -%}
                  {%- assign free_delivery_remaining = free_delivery_goal | minus: cart.total_price -%}
                  {%- assign free_delivery_progress = cart.total_price | times: 100.0 | divided_by: free_delivery_goal | at_most: 100 -%}
                  <div class="cart-drawer__delivery" role="status">
                    <div class="cart-drawer__delivery-copy">
                      <span class="cart-drawer__delivery-prompt">
                        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="7.5" cy="18" r="2" fill="currentColor"/><circle cx="17.5" cy="18" r="2" fill="currentColor"/></svg>
                        <span>{% if free_delivery_remaining > 0 %}Add <strong>{{ free_delivery_remaining | money }}</strong> more for free delivery{% else %}Free delivery unlocked{% endif %}</span>
                      </span>
                      <span>{{ cart.total_price | money }} / {{ free_delivery_goal | money }}</span>
                    </div>
                    <span class="cart-drawer__delivery-track"><span style="width: {{ free_delivery_progress }}%"></span></span>
                    <div class="cart-drawer__delivery-note">
                      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 8h16v12H4zM2 5h20v3H2zM12 5v15M12 5c-5 0-6-4-3-4 2 0 3 2 3 4Zm0 0c5 0 6-4 3-4-2 0-3 2-3 4Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span>{% if free_delivery_remaining > 0 %}You’re {{ free_delivery_remaining | money }} away from free delivery{% else %}Your order qualifies for free delivery{% endif %}</span>
                    </div>
                  </div>
                {%- endif -%}
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% assign cart_subtotal = cart.items_subtotal_price | money %}
                  <div class="cart-drawer__cost-row"><span>Subtotal ({{ cart.item_count }} items)</span><strong>{{ cart_subtotal }}</strong></div>
                  <div class="cart-drawer__cost-row"><span>Delivery</span><span>Calculated at checkout</span></div>
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                  <button type="button" class="cart-drawer__continue" on:click="#cart-drawer/close">Continue shopping</button>
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .cart-drawer__dialog {
    --theme-drawer-width: min(760px, calc(100vw - 48px));
    box-sizing: border-box;
    position: fixed;
    inset: 50% auto auto 50%;
    z-index: calc(var(--layer-menu-drawer, 18) + 1);
    width: var(--theme-drawer-width);
    max-width: calc(100vw - 48px);
    height: min(820px, calc(100dvh - 48px));
    max-height: calc(100dvh - 48px);
    margin: 0;
    padding: 0;
    border: 1px solid rgb(var(--color-foreground-rgb) / .12);
    border-radius: 18px;
    box-shadow: 0 24px 80px rgb(18 34 21 / .26);
    transform: translate(-50%, -50%);
    background: var(--freshomill-color-surface-warm);
  }

  #cart-drawer .cart-drawer__dialog { padding: 0; }

  .cart-drawer__dialog[open] { inset: 50% auto auto 50% !important; }
  .cart-drawer__dialog::backdrop { background: rgb(17 28 18 / .48); backdrop-filter: blur(5px); }
  .cart-drawer__dialog--opening { animation: cart-popup-in .2s ease-out; }
  .cart-drawer__dialog--closing { animation: cart-popup-out .16s ease-in forwards; }
  @keyframes cart-popup-in {
    from { opacity: 0; transform: translate(-50%, calc(-50% + 8px)) scale(.99); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  @keyframes cart-popup-out {
    to { opacity: 0; transform: translate(-50%, calc(-50% + 8px)) scale(.99); }
  }

  .cart-drawer__dialog .theme-drawer__header {
    flex: 0 0 auto;
    gap: 12px;
    padding: 24px 28px 16px;
    background: var(--freshomill-color-surface-warm);
  }

  .cart-drawer__dialog .theme-drawer__title {
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 700;
  }

  .cart-drawer__dialog .theme-drawer__badge {
    min-width: 0;
    height: auto;
    padding: 0;
    background: transparent;
    font-size: var(--freshomill-font-size-small);
    color: var(--freshomill-color-muted);
  }
  .cart-drawer__dialog .theme-drawer__badge::after { content: ' items'; }

  .cart-drawer__clear-form { margin-inline-start: auto; }
  .cart-drawer__clear {
    display: inline-flex;
    min-height: var(--freshomill-touch-target);
    align-items: center;
    border: 0;
    padding: 6px 0;
    background: transparent;
    color: var(--freshomill-color-brand-strong);
    text-decoration: underline;
    font: inherit;
    font-size: var(--freshomill-font-size-small);
    cursor: pointer;
  }

  .cart-drawer__delivery {
    flex: 0 0 auto;
    padding: 16px 28px 18px;
    background: var(--freshomill-color-surface-warm);
    color: var(--freshomill-color-ink);
    font-size: var(--freshomill-font-size-small);
  }

  .cart-drawer__delivery-copy { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; }
  .cart-drawer__delivery-prompt { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .cart-drawer__delivery-prompt svg { width: 24px; height: 24px; flex: 0 0 auto; }
  .cart-drawer__delivery-prompt > span { min-width: 0; overflow-wrap: anywhere; }
  .cart-drawer__delivery-copy > :last-child { flex: 0 0 auto; white-space: nowrap; }
  .cart-drawer__delivery-track { display: block; height: 8px; margin-top: 12px; overflow: hidden; border-radius: 99px; background: var(--freshomill-color-border); }
  .cart-drawer__delivery-track > span { display: block; height: 100%; border-radius: inherit; background: var(--freshomill-color-brand-strong); }
  .cart-drawer__delivery-note { display: flex; align-items: center; gap: 9px; margin-top: 12px; padding: 10px 12px; border-radius: var(--freshomill-radius-card); background: var(--freshomill-color-brand-soft); color: var(--freshomill-color-brand-strong); font-weight: 600; }
  .cart-drawer__delivery-note svg { width: 21px; height: 21px; flex: 0 0 auto; }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow: hidden;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    flex: 0 0 auto;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    padding: 14px 20px max(16px, var(--safe-area-inset-bottom));
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: none;

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .cart-drawer__cost-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; color: var(--color-foreground); font-size: var(--freshomill-font-size-small); }
  .cart-drawer__cost-row + .cart-drawer__cost-row { margin-top: -5px; color: var(--color-foreground-subdued); }
  .cart-drawer__summary .cart-totals { gap: 10px; }
  .cart-drawer__summary .cart-totals__total { padding-top: 10px; border-top: 1px solid rgb(var(--color-foreground-rgb) / .12); }
  .cart-drawer__summary .cart__ctas { width: 100%; }
  .cart-drawer__summary .cart__checkout-button,
  .cart-drawer__continue { width: 100%; min-height: 48px; border-radius: var(--freshomill-radius-control); font-weight: 700; }
  .cart-drawer__continue { border: 1px solid var(--freshomill-color-brand-strong); background: transparent; color: var(--freshomill-color-brand-strong); cursor: pointer; }

  .cart-drawer__items .cart-items__table-row {
    grid-template-columns: 88px minmax(0, 1fr) 64px;
    grid-template-areas: 'media details price' 'media quantity quantity' 'media error error';
    column-gap: 14px;
    padding-bottom: 14px;
    margin-bottom: 14px;
  }
  .cart-drawer__items .cart-items__table-row .cart-items__quantity { grid-area: quantity; }
  .cart-drawer__items .cart-items__table-row .cart-items__price { grid-area: price; }
  .cart-drawer__items .cart-items__table-row--full-width-variants {
    grid-template-rows: repeat(5, min-content);
    grid-template-areas: 'media details price' 'media variants variants' 'media unit_price unit_price' 'media quantity quantity' 'media error error';
  }
  .cart-drawer__items .cart-items__media-container { border-radius: var(--freshomill-radius-card); background: var(--freshomill-color-surface-warm); }
  .cart-drawer__items .cart-items__media-container { width: 88px; }
  .cart-drawer__items .cart-items__media-image { object-fit: inherit; }
  .cart-drawer__items .cart-items__title { font-size: var(--freshomill-font-size-body); font-weight: 650; }
  .cart-drawer__items .cart-items__details * { font-size: var(--freshomill-font-size-small); }
  .cart-drawer__items .cart-items__price { min-width: 56px; color: var(--freshomill-color-ink); font-weight: 700; }
  .cart-drawer__items .cart-items__quantity { margin-top: 8px; }
  .cart-drawer__items .cart-items__remove { width: var(--freshomill-touch-target); min-height: var(--freshomill-touch-target); height: var(--freshomill-touch-target); }

  /* Keep cart content inside the dialog even with long product names or prices. */
  .cart-drawer__items,
  .cart-drawer__items .cart-items-component,
  .cart-drawer__items .cart-items__wrapper,
  .cart-drawer__items .cart-items__table,
  .cart-drawer__items .cart-items__table-row,
  .cart-drawer__items .cart-items__details,
  .cart-drawer__items .cart-items__product-info,
  .cart-drawer__items .cart-items__variants-wrapper {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .cart-drawer__items .cart-items__table { table-layout: fixed; }
  .cart-drawer__items .cart-items__table-row { width: 100%; }
  .cart-drawer__items .cart-items__title-row { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 4px; }
  .cart-drawer__items .cart-items__title {
    display: inline-block;
    max-width: 100%;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: normal;
  }
  .cart-drawer__items .cart-items__variants,
  .cart-drawer__items .cart-items__variant,
  .cart-drawer__items .cart-items__variants-wrapper,
  .cart-drawer__items .cart-items__properties,
  .cart-drawer__items .cart-items__property {
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: normal;
  }
  .cart-drawer__items .cart-items__quantity,
  .cart-drawer__items .cart-items__quantity-controls { min-width: 0; max-width: 100%; }
  .cart-drawer__items .cart-items__quantity-controls { flex-wrap: wrap; }
  .cart-drawer__items .cart-items__price {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }
  .cart-drawer__items .cart-items__price bdi { white-space: normal; }
  .cart-drawer__cost-row { min-width: 0; line-height: 1.4; }
  .cart-drawer__cost-row > :first-child { min-width: 0; }
  .cart-drawer__cost-row > :last-child { max-width: 55%; text-align: end; overflow-wrap: anywhere; }

  @media screen and (max-width: 749px) {
    .cart-drawer__dialog,
    .cart-drawer__dialog[open] {
      inset: 50% auto auto 50% !important;
      transform: translate(-50%, -50%);
      margin: 0;
      width: min(92vw, 520px);
      max-width: calc(100vw - 24px);
      height: auto;
      max-height: calc(100dvh - 24px - var(--safe-area-inset-top) - var(--safe-area-inset-bottom));
      padding: 0;
      border: 1px solid rgb(var(--color-foreground-rgb) / .12);
      border-radius: 18px;
      box-shadow: 0 20px 60px rgb(0 0 0 / .24);
    }
    .cart-drawer__inner { height: auto; max-height: inherit; }
    .cart-drawer__inner > .cart-items-component { flex: 0 1 auto; }
    .cart-drawer__content { flex: 0 1 auto; max-height: min(64dvh, 560px); }
    .cart-drawer__items { flex: 0 1 auto; max-height: min(34dvh, 300px); }
    .cart-drawer__dialog--opening { animation-name: cart-popup-in; }
    .cart-drawer__dialog--closing { animation-name: cart-popup-out; }
    .cart-drawer__dialog .theme-drawer__header { padding: 18px 20px 12px; }
    .cart-drawer__content { min-height: 0; overflow: hidden; }
    .cart-drawer__items { flex: 1 1 0; min-height: 0; overflow-x: hidden; overflow-y: auto; }
    .cart-drawer__summary { position: relative; flex: 0 0 auto; padding-inline: 16px; }
    .cart-drawer__delivery { padding: 12px 16px; }
    .cart-drawer__delivery-copy { align-items: flex-start; gap: 8px; font-size: var(--freshomill-font-size-caption); }
    .cart-drawer__delivery-copy > :last-child { max-width: 36%; font-size: var(--freshomill-font-size-caption); text-align: end; white-space: normal; overflow-wrap: anywhere; }
    .cart-drawer__delivery-note { margin-top: 9px; padding: 8px 10px; font-size: var(--freshomill-font-size-caption); }
    .cart-drawer__cost-row { font-size: var(--freshomill-font-size-caption); }
    .cart-drawer__items .cart-items__table-row { grid-template-columns: 72px minmax(0, 1fr) 58px; column-gap: 10px; }
    .cart-drawer__items .cart-items__table-row--full-width-variants { grid-template-columns: 72px minmax(0, 1fr) 58px; }
    .cart-drawer__items .cart-items__title { font-size: var(--freshomill-font-size-small); }
    .cart-drawer__items .cart-items__details * { font-size: var(--freshomill-font-size-caption); }
    .cart-drawer__items .cart-items__price { font-size: var(--freshomill-font-size-caption); }
    .cart-drawer__items .cart-items__quantity-controls { gap: 6px; }
    .cart-drawer__items .cart-items__remove { flex: 0 0 var(--freshomill-touch-target); }
    .cart-drawer__summary { align-items: stretch; gap: 10px; }
    .cart-drawer__summary .cart-totals,
    .cart-drawer__summary .cart__summary-totals { min-width: 0; width: 100%; }
    .cart-drawer__summary .cart-totals__total { gap: 10px; }
    .cart-drawer__summary .cart-totals__total-value { white-space: nowrap; }
    .cart-drawer__summary .cart-totals__total-value { font-size: var(--font-size--lg); }
  }

  @media screen and (max-width: 380px) {
    .cart-drawer__dialog .theme-drawer__header { gap: 8px; padding-inline: 14px; }
    .cart-drawer__dialog .theme-drawer__title { font-size: 21px; }
    .cart-drawer__delivery { padding-inline: 12px; }
    .cart-drawer__items { padding-inline: 12px; }
    .cart-drawer__items .cart-items__table-row { grid-template-columns: 62px minmax(0, 1fr) 68px; column-gap: 8px; }
    .cart-drawer__items .cart-items__table-row--full-width-variants { grid-template-columns: 62px minmax(0, 1fr) 68px; }
    .cart-drawer__items .cart-items__media-container { width: 62px; }
    .cart-drawer__summary { padding-inline: 12px; }
  }

  @media screen and (max-height: 680px) {
    .cart-drawer__dialog .theme-drawer__header { padding-block: 12px 8px; }
    .cart-drawer__delivery { padding-block: 9px 10px; }
    .cart-drawer__delivery-track { margin-top: 8px; }
    .cart-drawer__delivery-note { margin-top: 7px; padding-block: 6px; }
    .cart-drawer__summary { gap: 7px; padding-block: 9px max(10px, var(--safe-area-inset-bottom)); }
    .cart-drawer__summary .cart-totals { gap: 6px; }
    .cart-drawer__summary .cart-totals__total { padding-top: 6px; }
    .cart-drawer__summary .cart__checkout-button,
    .cart-drawer__continue { min-height: 40px; }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
