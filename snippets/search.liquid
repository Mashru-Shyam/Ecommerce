{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% if style == 'inline' %}
  {% assign header_search_term = search.terms | default: request.params.q %}
  <script src="{{ 'header-search-clear.js' | asset_url }}" defer type="module"></script>
  <form
    class="header-search"
    action="{{ routes.search_url }}"
    method="get"
    role="search"
  >
    <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">
      {{- 'content.search_input_label' | t -}}
    </label>
    <span class="header-search__icon" aria-hidden="true">
      {{ 'icon-search.svg' | inline_asset_content }}
    </span>
    <input
      id="HeaderSearch-{{ section.id }}"
      type="search"
      name="q"
      value="{{ header_search_term | escape }}"
      placeholder="{{ 'content.search_input_placeholder' | t }}"
      autocomplete="off"
    >
    <button
      class="header-search__clear"
      type="button"
      aria-label="{{ 'accessibility.reset_search' | t }}"
      {% if header_search_term == blank %}hidden{% endif %}
    >
      <span class="svg-wrapper" aria-hidden="true">{{ 'icon-close.svg' | inline_asset_content }}</span>
    </button>
    <input name="type" type="hidden" value="product">
    <input name="options[prefix]" type="hidden" value="last">
    <button type="submit" aria-label="{{ 'content.search' | t }}">
      <span class="svg-wrapper" aria-hidden="true">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </form>
{% elsif style != 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.search' | t }}
      </span>

      <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
{% endif %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  .header-search {
    display: flex;
    align-items: stretch;
    width: clamp(250px, 28vw, 380px);
    height: 40px;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--freshomill-color-border);
    border-radius: var(--freshomill-radius-card);
    background: var(--freshomill-color-surface);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .header-search:hover {
    border-color: var(--freshomill-color-muted);
  }

  .header-search:focus-within {
    border-color: var(--freshomill-color-brand);
    box-shadow: 0 0 0 2px var(--freshomill-color-focus-ring);
  }

  .header-search input {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    padding: 0 12px 0 8px;
    border: 0;
    outline: 0;
    color: var(--freshomill-color-ink);
    background: transparent;
    font: inherit;
    font-size: 0.9rem;
  }

  .header-search__icon {
    display: grid;
    flex: 0 0 44px;
    place-items: center;
    color: var(--freshomill-color-ink);
  }

  .header-search__icon svg {
    width: 20px;
    height: 20px;
  }

  .header-search .header-search__clear {
    display: grid;
    flex: 0 0 36px;
    place-items: center;
    padding: 0;
    border: 0;
    color: var(--freshomill-color-muted);
    background: transparent;
    cursor: pointer;
  }

  .header-search .header-search__clear svg {
    width: 16px;
    height: 16px;
  }

  .header-search .header-search__clear[hidden] {
    display: none;
  }

  .header-search input::placeholder {
    color: var(--freshomill-color-muted);
    opacity: 1;
  }

  .header-search button {
    display: grid;
    flex: 0 0 48px;
    place-items: center;
    padding: 0;
    border: 0;
    color: var(--freshomill-color-surface);
    background: var(--freshomill-color-brand);
    cursor: pointer;
  }

  .header-search button .svg-wrapper,
  .header-search button svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }
{% endstylesheet %}
