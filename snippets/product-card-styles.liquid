{%- doc -%}
  Product card layout styles. Kept in a standalone snippet so empty filtered grids
  can preload the styles before facets morph product cards into the section.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Shared product-card foundation for collection, home, search, and related grids. */
  .freshomill-product-card .product-card__content {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    box-sizing: border-box;
    height: 100%;
    min-height: 100%;
    gap: 8px !important;
    padding: 8px !important;
    overflow: hidden;
    border: 1px solid var(--freshomill-color-border, #e4e9df);
    border-radius: var(--freshomill-radius-card, 10px);
    background: var(--freshomill-color-surface, #fff);
  }

  .freshomill-product-card .product-card__content > * {
    min-width: 0;
  }

  .freshomill-product-card .card-gallery {
    box-sizing: border-box;
    width: calc(100% + 16px) !important;
    margin: -8px -8px 0 !important;
    padding: 0 !important;
    padding-inline: 0 !important;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: var(--freshomill-radius-card, 10px) var(--freshomill-radius-card, 10px) var(--freshomill-radius-control, 6px) var(--freshomill-radius-control, 6px);
    background: var(--freshomill-color-surface, #fff);
  }

  .freshomill-product-card .card-gallery .product-media-container {
    --product-media-fit: cover !important;
    width: 100%;
    height: 100%;
    max-height: none;
  }

  .freshomill-product-card .card-gallery .product-media-container img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover !important;
    object-position: center;
  }

  .freshomill-product-card .product-card__content > a.contents {
    display: block;
    width: 100%;
    min-height: 2.5em;
    color: var(--freshomill-color-ink, #1d2a20);
    text-decoration: none;
  }

  .freshomill-product-card .product-card__content > a.contents :is(.text-block, p) {
    color: var(--freshomill-color-ink, #1d2a20);
    font-size: var(--freshomill-font-size-caption, .75rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .freshomill-product-card .product-card__content > a.contents p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .freshomill-product-card .product-card__content product-price {
    display: block;
    width: 100%;
    color: var(--freshomill-color-ink, #1d2a20);
    font-size: var(--freshomill-font-size-small, .8125rem);
    line-height: 1.2;
  }

  .freshomill-product-card .product-card__content product-price :is(.price, .price-item__group) {
    color: var(--freshomill-color-ink, #1d2a20);
    font-size: var(--freshomill-font-size-small, .8125rem);
    font-weight: 750;
    line-height: 1.2;
  }

  .freshomill-product-card .product-card__content product-price .compare-at-price {
    margin-inline-start: 4px;
    color: var(--freshomill-color-muted, #68736b);
    font-size: var(--freshomill-font-size-caption, .75rem);
    font-weight: 400;
    text-decoration: line-through;
  }

  .freshomill-product-card .product-card__content product-price .unit-price {
    display: block;
    margin-top: 2px;
    color: var(--freshomill-color-muted, #68736b);
    font-size: var(--freshomill-font-size-caption, .75rem);
    font-weight: 400;
  }

  .freshomill-product-card .product-card__content > quick-add-component.quick-add {
    position: relative !important;
    inset: auto !important;
    z-index: 2;
    display: flex !important;
    width: 100% !important;
    min-height: var(--freshomill-touch-target, 44px) !important;
    margin-top: auto !important;
    flex: 0 0 var(--freshomill-touch-target, 44px) !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }

  .freshomill-product-card .product-card__content > quick-add-component :is(.quick-add__product-form-component, form, .quick-add__button) {
    width: 100% !important;
    max-width: 100% !important;
    min-height: var(--freshomill-touch-target, 44px) !important;
  }

  .freshomill-product-card .product-card__content > quick-add-component .quick-add__button {
    position: relative !important;
    inset: auto !important;
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: none !important;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid var(--freshomill-color-border, #e4e9df);
    border-radius: var(--freshomill-radius-control, 6px);
    background: var(--freshomill-color-surface, #fff);
    color: var(--freshomill-color-brand-strong, #145b35);
    font-size: var(--freshomill-font-size-caption, .75rem);
    font-weight: 650;
    line-height: 1.1;
  }

  .freshomill-product-card .product-card__content > quick-add-component .quick-add__button:hover {
    border-color: var(--freshomill-color-brand-hover, #0d5415);
    background: var(--freshomill-color-brand-soft, #edf5e8);
  }

  .freshomill-product-card .product-card__content > .freshomill-quick-add-unavailable {
    display: flex;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: var(--freshomill-touch-target, 44px);
    margin-top: auto;
    flex: 0 0 var(--freshomill-touch-target, 44px);
  }

  .freshomill-product-card .freshomill-quick-add-unavailable .quick-add__button {
    position: relative;
    inset: auto;
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: var(--freshomill-touch-target, 44px);
    margin: 0;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid var(--freshomill-color-border, #e4e9df);
    border-radius: var(--freshomill-radius-control, 6px);
    background: var(--freshomill-color-brand-soft, #edf5e8);
    color: var(--freshomill-color-muted, #68736b);
    font-size: var(--freshomill-font-size-caption, .75rem);
    font-weight: 650;
    line-height: 1.1;
    cursor: not-allowed;
    opacity: .8;
  }

  .freshomill-product-card .freshomill-quick-add-unavailable .svg-wrapper {
    display: inline-flex;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  .freshomill-product-card .freshomill-quick-add-unavailable svg {
    width: 100%;
    height: 100%;
  }

  .product-grid__card.product-grid__card {
    display: flex;
    flex-flow: column nowrap;
    gap: var(--product-card-gap);
    align-items: var(--product-card-alignment);
    text-decoration: none;
    color: var(--color, var(--color-foreground));
    padding-block: var(--padding-block-start) var(--padding-block-end);
    padding-inline: var(--padding-inline-start) var(--padding-inline-end);
    overflow: hidden;
  }

  .product-grid__card swatches-variant-picker-component overflow-list::part(list) {
    flex-wrap: wrap;
  }

  /*
    Product cards are narrow, so group content stacks on mobile. A group that
    turns "vertical on mobile" off renders without .mobile-column and keeps the
    horizontal direction it was given.
  */
  .product-grid__card .group-block > :is(.mobile-column, :not(.layout-panel-flex--row)) {
    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  /* Collection and product list cards have equal heights */
  :is(.product-grid__item, .resource-list__item) .product-card {
    display: grid;
    height: 100%;
  }

  /* Product card title truncation - applied on mobile regardless of view */
  @media screen and (max-width: 749px) {
    .freshomill-product-card .card-gallery {
      width: calc(100% + 14px) !important;
      margin: -7px -7px 0 !important;
      padding: 0 !important;
      padding-inline: 0 !important;
    }

    :is(.product-card, .product-grid__card) :is(h4, .h4) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      -webkit-line-clamp: 3;
    }
  }

  .product-card__placeholder-image svg {
    height: 100%;
  }

  .product-card__content slideshow-component {
    --cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .product-card slideshow-arrows .slideshow-control {
      display: none;
    }
  }
{% endstylesheet %}
