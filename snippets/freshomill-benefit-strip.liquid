{% liquid
  assign benefit_context = context | default: 'store'
%}

<section class="freshomill-benefit-strip freshomill-benefit-strip--{{ benefit_context }}" aria-label="{{ 'benefit_strip.label' | t }}">
  <ul class="freshomill-benefit-strip__list" role="list">
    {% if benefit_context == 'product' %}
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5c-7.6 0-13 3.8-13 10.1 0 2.4 1.6 4.1 3.8 4.1 6.1 0 9.2-6.8 9.2-14.2ZM5 21c2.2-5.4 5.6-8.9 10.1-11.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.packed_title' | t }}</strong><small>{{ 'benefit_strip.packed_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v5.5c0 4.8-3.3 7.8-8 9.5-4.7-1.7-8-4.7-8-9.5V6l8-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><path d="m8.5 11.8 2.2 2.2 4.8-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.secure_title' | t }}</strong><small>{{ 'benefit_strip.secure_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12H3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h2v-7H4Zm16 0h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2v-7h1Zm-4 8a4 4 0 0 1-4 3h-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.support_title' | t }}</strong><small>{{ 'benefit_strip.support_detail' | t }}</small></span>
      </li>
    {% elsif benefit_context == 'contact' %}
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5c-7.6 0-13 3.8-13 10.1 0 2.4 1.6 4.1 3.8 4.1 6.1 0 9.2-6.8 9.2-14.2ZM5 21c2.2-5.4 5.6-8.9 10.1-11.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.quality_title' | t }}</strong><small>{{ 'benefit_strip.quality_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><circle cx="7" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.delivery_title' | t }}</strong><small>{{ 'benefit_strip.delivery_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v5.5c0 4.8-3.3 7.8-8 9.5-4.7-1.7-8-4.7-8-9.5V6l8-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><path d="m8.5 11.8 2.2 2.2 4.8-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.secure_title' | t }}</strong><small>{{ 'benefit_strip.safe_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.6 9a7 7 0 0 1 11.7-2L20 9M4 15l2.7 2a7 7 0 0 0 11.7-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.returns_title' | t }}</strong><small>{{ 'benefit_strip.returns_detail' | t }}</small></span>
      </li>
    {% else %}
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><circle cx="7" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.free_delivery_title' | t }}</strong><small>{{ 'benefit_strip.free_delivery_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v5.5c0 4.8-3.3 7.8-8 9.5-4.7-1.7-8-4.7-8-9.5V6l8-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><path d="m8.5 11.8 2.2 2.2 4.8-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.secure_title' | t }}</strong><small>{{ 'benefit_strip.secure_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5M5.6 9a7 7 0 0 1 11.7-2L20 9M4 15l2.7 2a7 7 0 0 0 11.7-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.returns_title' | t }}</strong><small>{{ 'benefit_strip.returns_detail' | t }}</small></span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13v-2a8 8 0 0 1 16 0v2M4 12H3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h2v-7H4Zm16 0h1a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2v-7h1Zm-4 8a4 4 0 0 1-4 3h-2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span><strong>{{ 'benefit_strip.support_title' | t }}</strong><small>{{ 'benefit_strip.support_detail' | t }}</small></span>
      </li>
    {% endif %}
  </ul>
</section>

{% stylesheet %}
  .freshomill-benefit-strip {
    width: 100%;
    color: var(--freshomill-color-ink, #1d2a20);
    background: var(--freshomill-color-brand-soft, #edf5e8);
  }

  .product-information > .freshomill-benefit-strip {
    grid-column: 1 / -1;
  }

  .freshomill-benefit-strip__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: var(--page-content-width, var(--wide-page-width, 150rem));
    margin: 0 auto;
    padding: 12px var(--freshomill-page-gutter, 24px);
    list-style: none;
  }

  .freshomill-benefit-strip--product .freshomill-benefit-strip__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: var(--page-content-width, var(--wide-page-width, 150rem));
    padding-inline: 0;
  }

  .freshomill-benefit-strip__list li {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 12px;
  }

  .freshomill-benefit-strip__list li + li {
    border-inline-start: 1px solid rgb(20 91 53 / 16%);
  }

  .freshomill-benefit-strip__list svg {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    fill: none;
    stroke: var(--freshomill-color-brand-strong, #145b35);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .freshomill-benefit-strip__list span {
    display: grid;
    min-width: 0;
    gap: 2px;
  }

  .freshomill-benefit-strip__list strong {
    font-size: var(--freshomill-font-size-small, .8125rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .freshomill-benefit-strip__list small {
    color: var(--freshomill-color-muted, #68736b);
    font-size: var(--freshomill-font-size-caption, .75rem);
    line-height: 1.3;
  }

  @media screen and (max-width: 749px) {
    .freshomill-benefit-strip__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 8px var(--freshomill-page-gutter, 16px);
    }

    .freshomill-benefit-strip--product .freshomill-benefit-strip__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-inline: 0;
    }

    .freshomill-benefit-strip__list li {
      justify-content: flex-start;
      gap: 7px;
      padding: 8px 6px;
    }

    .freshomill-benefit-strip__list li:nth-child(odd) {
      border-inline-start: 0;
    }

    .freshomill-benefit-strip--product .freshomill-benefit-strip__list li:nth-child(odd) {
      border-inline-start: 0;
    }

    .freshomill-benefit-strip--product .freshomill-benefit-strip__list li:nth-child(3) {
      border-inline-start: 1px solid rgb(20 91 53 / 16%);
    }

    .freshomill-benefit-strip__list svg {
      width: 26px;
      height: 26px;
      flex-basis: 26px;
    }

    .freshomill-benefit-strip__list strong {
      font-size: var(--freshomill-font-size-caption, .75rem);
    }

    .freshomill-benefit-strip__list small {
      font-size: 11px;
    }
  }

  @media screen and (max-width: 389px) {
    .freshomill-benefit-strip--product .freshomill-benefit-strip__list li {
      gap: 5px;
      padding-inline: 3px;
    }

    .freshomill-benefit-strip--product .freshomill-benefit-strip__list svg {
      width: 22px;
      height: 22px;
      flex-basis: 22px;
    }

    .freshomill-benefit-strip--product .freshomill-benefit-strip__list small {
      font-size: 10px;
    }
  }
{% endstylesheet %}
