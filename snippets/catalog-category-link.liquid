{% doc %}
  Renders a collection link for the catalog category navigation.

  @param {collection} category - Collection to link to
  @param {collection} active_collection - Current collection
{% enddoc %}

<a class="catalog-category{% if active_collection.handle == category.handle %} is-active{% endif %}" href="{{ category.url }}">
  <span class="catalog-category__icon" aria-hidden="true">
    {% if category.image != blank %}
      {{ category.image | image_url: width: 48 | image_tag: width: 18, height: 18, loading: 'lazy', alt: '' }}
    {% else %}
      <svg viewBox="0 0 20 20" focusable="false"><path d="M10 2.5c-3.6 0-6.5 2.9-6.5 6.5s2.9 6.5 6.5 6.5 6.5-2.9 6.5-6.5S13.6 2.5 10 2.5Zm0 3.2v5.1m-2.6-2.5h5.2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"/></svg>
    {% endif %}
  </span>
  <span>{{ category.title | escape }}</span>
  <span class="catalog-category__count">{{ category.products_count }}</span>
</a>
