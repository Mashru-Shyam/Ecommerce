

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true %}
        </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true %}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="cart-page__title">
        {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
      </div>

      <div class="cart-page__items">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  /* A full cart page should use normal document scrolling, not drawer-style nested scrolling. */
  cart-items-component:not([data-drawer]):has(.cart-page) {
    display: block;
    height: auto;
    min-height: 0;
  }

  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__items,
  .cart-page__items .cart-items__wrapper {
    min-width: 0;
    width: 100%;
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  .cart-page__summary .cart-summary__inner {
    gap: var(--gap-lg);
    padding: var(--padding-lg);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: var(--freshomill-radius-panel);
    background: var(--freshomill-color-surface-warm);
    box-shadow: 0 5px 20px rgb(34 53 35 / 0.05);
  }

  .cart-page__summary .cart__checkout-button {
    width: 100%;
    min-height: 48px;
    border-radius: var(--freshomill-radius-control);
    font-weight: 700;
  }

  .cart-page__summary .cart__ctas { width: 100%; }

  .cart-page__title {
    grid-column: 1 / -1;
    margin-block-end: var(--freshomill-space-2);
  }

  .cart-page__title h1,
  .cart-page__title .h1,
  .cart-page__title .cart-title {
    color: var(--freshomill-color-ink);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 750;
    letter-spacing: -.04em;
    line-height: 1.1;
  }

  .cart-page__items .cart-items__wrapper {
    overflow: hidden;
    padding: clamp(14px, 2vw, 24px);
    border: 1px solid var(--freshomill-color-border);
    border-radius: var(--freshomill-radius-panel);
    background: var(--freshomill-color-surface);
    box-shadow: 0 5px 22px rgb(34 53 35 / .045);
  }

  .cart-page__summary .cart-summary__inner {
    gap: var(--freshomill-space-3);
    border-color: var(--freshomill-color-border);
    border-radius: var(--freshomill-radius-panel);
    background: var(--freshomill-color-surface);
    box-shadow: 0 5px 22px rgb(34 53 35 / .045);
  }

  .cart-page__summary .cart__checkout-button {
    min-height: 52px;
    font-size: var(--freshomill-font-size-body);
  }

  @media screen and (max-width: 749px) {
    .cart-page__title { margin-block-end: var(--freshomill-space-1); }
    .cart-page__items .cart-items__wrapper { padding: var(--freshomill-space-3); }
    .cart-page__summary .cart-summary__inner { padding: var(--padding-md); }
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: minmax(0, 1fr) minmax(280px, min(40vw, var(--sidebar-width)));
      grid-template-rows: min-content min-content;
      align-items: start;
    }

    .cart-page__title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .cart-page__items {
      grid-column: 1;
      grid-row: 2;
    }

    .cart-page__summary {
      display: block;
      height: max-content;
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      padding-top: 0;
      position: sticky;
      top: calc(var(--header-group-height, 0px) + var(--padding-lg));
    }

    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr minmax(
          var(--sidebar-width),
          calc((100vw - var(--page-width)) / 2 + var(--sidebar-width))
        );
    }
  }

  @media screen and (min-width: 1400px) {
    .cart-page {
      grid-template-columns: minmax(0, 1fr) var(--sidebar-width);
    }
  }

  @media screen and (max-width: 749px) {
    cart-items-component:not([data-drawer]):has(.cart-page) {
      overflow: visible;
    }

    .cart-page {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .cart-page__summary {
      position: static;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
