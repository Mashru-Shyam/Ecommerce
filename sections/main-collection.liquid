

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  const catalogWrapper = document.querySelector('.collection-wrapper--catalog');
  let catalogRequestId = 0;
  let activeCatalogPagination = null;
  let catalogHasInitialized = false;

  const getCatalogPageUrl = (results, direction) => {
    const items = results.querySelectorAll('.pagination:not(.catalog-pagination) .pagination__item');
    const edgeItem = direction === 'next' ? items[items.length - 1] : items[0];
    return edgeItem?.querySelector('.pagination__link--arrow[href]')?.href || null;
  };

  const getCatalogBaseUrl = (href) => {
    const nextUrl = new URL(href, window.location.href);
    nextUrl.searchParams.delete('page');
    nextUrl.searchParams.delete('catalog_page');
    return nextUrl.href;
  };

  const getCatalogColumns = (grid) => {
    const columns = getComputedStyle(grid).gridTemplateColumns.trim().split(/\s+/).filter(Boolean).length;
    if (columns > 0) return columns;

    const cards = Array.from(grid.children).filter((card) => !card.hidden);
    if (cards.length < 2) return 1;
    const firstRowTop = cards[0].getBoundingClientRect().top;
    const nextRowIndex = cards.findIndex((card) => Math.abs(card.getBoundingClientRect().top - firstRowTop) > 1);
    return nextRowIndex > 0 ? nextRowIndex : cards.length;
  };

  const getCatalogRowsPerPage = () => window.matchMedia('(max-width: 749px)').matches ? 5 : 3;

  const updateCatalogSourceKey = (state) => {
    state.sourceKey = Array.from(state.grid.children).map((card) => card.dataset.productId || card.id).join('|');
  };

  const registerCatalogBatch = (state, sourceResults, direction) => {
    const sourceGrid = sourceResults.querySelector('[data-testid="product-grid"]');
    if (!sourceGrid) return false;

    const serverPage = Number(sourceGrid.dataset.catalogServerPage) || 1;
    const pageOffset = (serverPage - 1) * state.serverPageSize;
    const fragment = document.createDocumentFragment();
    const cards = Array.from(sourceGrid.querySelectorAll(':scope > .product-grid__item'));

    cards.forEach((card, index) => {
      const itemIndex = pageOffset + index;
      if (state.itemsByIndex.has(itemIndex)) return;
      card.dataset.catalogItemIndex = String(itemIndex);
      state.itemsByIndex.set(itemIndex, card);
      if (sourceGrid !== state.grid) fragment.append(card);
    });

    if (sourceGrid !== state.grid) {
      if (direction === 'previous') state.grid.insertBefore(fragment, state.grid.firstElementChild);
      else state.grid.append(fragment);
    }

    state.total = Number(sourceGrid.dataset.catalogTotalItems) || 0;
    state.nativePages.set(serverPage, {
      previous: getCatalogPageUrl(sourceResults, 'previous'),
      next: getCatalogPageUrl(sourceResults, 'next'),
    });
    state.minServerPage = Math.min(state.minServerPage, serverPage);
    state.maxServerPage = Math.max(state.maxServerPage, serverPage);
    updateCatalogSourceKey(state);
    return true;
  };

  const fetchCatalogBatch = async (state, direction) => {
    if (state.batchRequest) await state.batchRequest;

    const boundaryPage = direction === 'previous' ? state.minServerPage : state.maxServerPage;
    const href = state.nativePages.get(boundaryPage)?.[direction];
    if (!href) return false;

    state.batchRequest = (async () => {
      const response = await fetch(href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if (!response.ok) throw new Error('More catalog products could not be loaded');
      const page = new DOMParser().parseFromString(await response.text(), 'text/html');
      const nextResults = page.querySelector('#ResultsList');
      if (!nextResults || !registerCatalogBatch(state, nextResults, direction)) {
        throw new Error('More catalog products were missing from the response');
      }
      return true;
    })();

    try {
      return await state.batchRequest;
    } finally {
      state.batchRequest = null;
    }
  };

  const ensureCatalogRange = async (state, start, end) => {
    while (start < (state.minServerPage - 1) * state.serverPageSize) {
      if (!(await fetchCatalogBatch(state, 'previous'))) break;
    }
    while (end > Math.min(state.total, state.maxServerPage * state.serverPageSize)) {
      if (!(await fetchCatalogBatch(state, 'next'))) break;
    }
    for (let index = start; index < end; index += 1) {
      if (!state.itemsByIndex.has(index)) return false;
    }
    return true;
  };

  const renderCatalogPagination = (state, currentPage, totalPages) => {
    let nav = state.results.querySelector('.catalog-pagination');
    if (totalPages <= 1) {
      nav?.remove();
      return;
    }

    if (!nav) {
      nav = document.createElement('nav');
      nav.className = 'pagination catalog-pagination';
      nav.setAttribute('aria-label', state.grid.dataset.catalogNavLabel || 'Pagination');
      const list = document.createElement('ul');
      list.className = 'pagination__list';
      list.setAttribute('role', 'list');
      nav.append(list);
      state.grid.insertAdjacentElement('afterend', nav);
    }

    const list = nav.querySelector('.pagination__list');
    const previousLabel = state.grid.dataset.catalogPreviousLabel || 'Previous page';
    const nextLabel = state.grid.dataset.catalogNextLabel || 'Next page';
    const pageLabel = state.grid.dataset.catalogPageLabel || 'Page __PAGE__';
    const pageHref = (page) => {
      const nextUrl = new URL(state.baseUrl);
      nextUrl.searchParams.set('catalog_page', String(page));
      return nextUrl.href;
    };
    const makeItem = (content, label, page, className, current = false) => {
      const item = document.createElement('li');
      item.className = 'pagination__item';
      if (className === 'pagination__link--gap') item.classList.add('pagination__item--gap');

      if (current || page === null) {
        const span = document.createElement('span');
        const isGap = className === 'pagination__link--gap';
        const isDisabled = page === null && !isGap;
        span.className = `pagination__link ${className}${current ? ' pagination__link--current' : ''}${isDisabled ? ' pagination__link--disabled' : ''}`;
        span.textContent = content;
        if (current) span.setAttribute('aria-current', 'page');
        if (isDisabled) {
          span.setAttribute('aria-label', label);
          span.setAttribute('aria-disabled', 'true');
        }
        if (isGap) span.setAttribute('aria-hidden', 'true');
        item.append(span);
        return item;
      }

      const link = document.createElement('a');
      link.className = `pagination__link ${className}`;
      link.href = pageHref(page);
      link.dataset.catalogPage = String(page);
      link.setAttribute('aria-label', label);
      link.textContent = content;
      item.append(link);
      return item;
    };

    const pages = new Set([1, totalPages]);
    for (let page = Math.max(1, currentPage - 1); page <= Math.min(totalPages, currentPage + 1); page += 1) pages.add(page);
    const orderedPages = Array.from(pages).sort((a, b) => a - b);
    const nodes = [makeItem('‹', previousLabel, currentPage > 1 ? currentPage - 1 : null, 'pagination__link--arrow')];
    let previousPage = 0;

    orderedPages.forEach((page) => {
      if (previousPage && page - previousPage > 1) nodes.push(makeItem('…', '', null, 'pagination__link--gap'));
      nodes.push(makeItem(String(page), pageLabel.replace('__PAGE__', String(page)), page, 'pagination__link--page', page === currentPage));
      previousPage = page;
    });

    nodes.push(makeItem('›', nextLabel, currentPage < totalPages ? currentPage + 1 : null, 'pagination__link--arrow'));
    list.replaceChildren(...nodes);
  };

  const showCatalogPage = async (state, requestedPage, historyMode = 'push') => {
    if (!state || state !== activeCatalogPagination) return;

    const renderRequestId = ++state.renderRequestId;
    state.pageSize = Math.max(1, getCatalogColumns(state.grid) * getCatalogRowsPerPage());
    const totalPages = Math.max(1, Math.ceil(state.total / state.pageSize));
    const currentPage = Math.min(Math.max(1, requestedPage), totalPages);
    const start = (currentPage - 1) * state.pageSize;
    const end = Math.min(state.total, start + state.pageSize);

    state.results.setAttribute('aria-busy', 'true');
    renderCatalogPagination(state, currentPage, totalPages);

    try {
      const hasRange = await ensureCatalogRange(state, start, end);
      if (state !== activeCatalogPagination || renderRequestId !== state.renderRequestId) return;
      if (!hasRange) throw new Error('The requested catalog page could not be completed');

      state.itemsByIndex.forEach((card, index) => {
        card.hidden = index < start || index >= end;
      });
      state.currentPage = currentPage;
      renderCatalogPagination(state, currentPage, totalPages);

      const nextUrl = new URL(state.baseUrl);
      if (currentPage > 1) nextUrl.searchParams.set('catalog_page', String(currentPage));
      if (historyMode === 'push' && nextUrl.href !== window.location.href) history.pushState({}, '', nextUrl.href);
      else if (historyMode === 'replace' && nextUrl.href !== window.location.href) history.replaceState({}, '', nextUrl.href);
    } catch (error) {
      if (state === activeCatalogPagination && renderRequestId === state.renderRequestId) console.error(error);
    } finally {
      if (state === activeCatalogPagination && renderRequestId === state.renderRequestId) state.results.removeAttribute('aria-busy');
    }
  };

  const initializeCatalogPagination = (results) => {
    const grid = results?.querySelector('[data-testid="product-grid"]');
    if (!grid) return;
    const firstInitialization = !catalogHasInitialized;
    catalogHasInitialized = true;
    const sourceKey = Array.from(grid.children).map((card) => card.dataset.productId || card.id).join('|');
    if (activeCatalogPagination?.results === results && activeCatalogPagination?.grid === grid && activeCatalogPagination?.sourceKey === sourceKey) return;

    const serverPageSize = Number(grid.dataset.catalogServerPageSize) || 8;
    const serverPage = Number(grid.dataset.catalogServerPage) || 1;
    const state = {
      results,
      grid,
      baseUrl: getCatalogBaseUrl(window.location.href),
      total: Number(grid.dataset.catalogTotalItems) || 0,
      serverPageSize,
      minServerPage: serverPage,
      maxServerPage: serverPage,
      nativePages: new Map(),
      itemsByIndex: new Map(),
      pageSize: Math.max(1, getCatalogColumns(grid) * getCatalogRowsPerPage()),
      currentPage: 1,
      sourceKey: '',
      batchRequest: null,
      renderRequestId: 0,
    };

    activeCatalogPagination = state;
    const nativeNav = results.querySelector('.pagination:not(.catalog-pagination)');
    if (nativeNav) {
      nativeNav.hidden = true;
      nativeNav.setAttribute('aria-hidden', 'true');
    }
    registerCatalogBatch(state, results, 'initial');

    const currentUrl = new URL(window.location.href);
    const requestedPage = firstInitialization ? Number(currentUrl.searchParams.get('catalog_page')) || 1 : 1;
    if (!firstInitialization && currentUrl.searchParams.has('catalog_page')) {
      currentUrl.searchParams.delete('catalog_page');
      history.replaceState({}, '', currentUrl.href);
    }
    const initialTotalPages = Math.max(1, Math.ceil(state.total / state.pageSize));
    const initialPage = Math.min(Math.max(1, requestedPage), initialTotalPages);
    const initialStart = (initialPage - 1) * state.pageSize;
    const initialEnd = Math.min(state.total, initialStart + state.pageSize);
    state.itemsByIndex.forEach((card, index) => {
      card.hidden = index < initialStart || index >= initialEnd;
    });
    showCatalogPage(state, requestedPage, 'replace');
  };

  if (catalogWrapper) {
    window.addEventListener('scroll', () => {
      catalogWrapper.querySelectorAll('.catalog-desktop-results-controls .sorting-filter .facets__panel[open]').forEach((panel) => {
        panel.open = false;
      });
    }, { passive: true });

    const updateCount = (selector, sourceDocument) => {
      const current = document.querySelector(selector);
      const source = sourceDocument.querySelector(selector);
      if (current && source) current.textContent = source.textContent;
    };

    const loadCatalogResults = async (href, selectedCategory) => {
      const currentResults = document.querySelector('#ResultsList');
      if (!currentResults) return;

      const resultsUrl = new URL(href, window.location.href);
      resultsUrl.searchParams.delete('page');
      resultsUrl.searchParams.delete('catalog_page');
      const normalizedHref = resultsUrl.href;

      const requestId = ++catalogRequestId;
      currentResults.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(normalizedHref, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (!response.ok) throw new Error('Catalog results could not be loaded');
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const nextResults = page.querySelector('#ResultsList');
        if (!nextResults) throw new Error('Catalog results were missing from the response');
        if (requestId !== catalogRequestId) return;

        activeCatalogPagination = null;
        currentResults.replaceWith(nextResults);
        history.pushState({}, '', normalizedHref);
        updateCount('.catalog-desktop-results-controls [data-testid="products-count"]', page);
        updateCount('.catalog-mobile-products-count', page);
        initializeCatalogPagination(nextResults);

        if (selectedCategory) {
          const selectedCategoryPath = new URL(selectedCategory.href, window.location.href).pathname;
          document.querySelectorAll('.catalog-category').forEach((link) => {
            const isSelected = new URL(link.href, window.location.href).pathname === selectedCategoryPath;
            link.classList.toggle('is-active', isSelected);
            link.classList.remove('is-pending');
            if (isSelected) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          });
          if (selectedCategory.closest('#filters-drawer')) document.getElementById('filters-drawer')?.close();
        }
      } catch (error) {
        if (requestId === catalogRequestId) window.location.assign(normalizedHref);
      } finally {
        if (requestId === catalogRequestId) document.querySelector('#ResultsList')?.removeAttribute('aria-busy');
      }
    };

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const categoryLink = event.target.closest('.catalog-category');
      const pageLink = event.target.closest('#ResultsList .catalog-pagination a[data-catalog-page]');
      if (pageLink && !event.defaultPrevented && event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {
        event.preventDefault();
        showCatalogPage(activeCatalogPagination, Number(pageLink.dataset.catalogPage));
        return;
      }
      if (!categoryLink || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      event.preventDefault();
      loadCatalogResults(categoryLink.href, categoryLink);
    });

    const catalogResultsObserver = new MutationObserver(() => {
      const results = document.querySelector('#ResultsList');
      const grid = results?.querySelector('[data-testid="product-grid"]');
      const sourceKey = grid ? Array.from(grid.children).map((card) => card.dataset.productId || card.id).join('|') : '';
      if (results && grid && (activeCatalogPagination?.results !== results || activeCatalogPagination?.grid !== grid || activeCatalogPagination?.sourceKey !== sourceKey)) {
        initializeCatalogPagination(results);
      }
    });
    catalogResultsObserver.observe(catalogWrapper, { childList: true, subtree: true });
    initializeCatalogPagination(document.querySelector('#ResultsList'));

    window.addEventListener('resize', () => {
      const state = activeCatalogPagination;
      if (!state) return;
      const anchorIndex = (state.currentPage - 1) * state.pageSize;
      const nextPageSize = Math.max(1, getCatalogColumns(state.grid) * 2);
      if (nextPageSize === state.pageSize) return;
      state.pageSize = nextPageSize;
      showCatalogPage(state, Math.floor(anchorIndex / nextPageSize) + 1, 'replace');
    }, { passive: true });

    window.addEventListener('popstate', () => {
      const state = activeCatalogPagination;
      if (!state) return;
      if (getCatalogBaseUrl(window.location.href) !== state.baseUrl) {
        window.location.reload();
        return;
      }
      const page = Number(new URL(window.location.href).searchParams.get('catalog_page')) || 1;
      showCatalogPage(state, page, 'replace');
    });
  }

  // Let shoppers dismiss the mobile filter sheet with a downward header swipe.
  // The gesture starts in the header only, so scrolling filter options remains native.
  if (!window.__freshomillFilterSheetSwipeBound) {
    window.__freshomillFilterSheetSwipeBound = true;

    let filterSheetSwipe = null;

    document.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.pointerType === 'mouse' || !window.matchMedia('(max-width: 749px)').matches) return;
      if (!(event.target instanceof Element) || event.target.closest('.theme-drawer__close-button')) return;

      const header = event.target.closest('#filters-drawer .theme-drawer__header');
      const drawer = document.getElementById('filters-drawer');
      const panel = drawer?.querySelector('.theme-drawer__dialog');
      if (!header || !drawer?.isOpen || !panel) return;

      filterSheetSwipe = {
        drawer,
        panel,
        header,
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        lastY: event.clientY,
        lastTime: event.timeStamp,
        velocityY: 0,
        dragging: false,
      };
    });

    document.addEventListener('pointermove', (event) => {
      const swipe = filterSheetSwipe;
      if (!swipe || event.pointerId !== swipe.pointerId) return;

      const deltaX = event.clientX - swipe.startX;
      const deltaY = event.clientY - swipe.startY;
      if (!swipe.dragging) {
        if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 8) {
          filterSheetSwipe = null;
          return;
        }
        if (deltaY < 8) return;
        swipe.dragging = true;
        try {
          swipe.header.setPointerCapture(event.pointerId);
        } catch (_) {
          // Pointer capture is an enhancement; document listeners still handle the gesture.
        }
      }

      event.preventDefault();
      const now = event.timeStamp;
      const elapsed = Math.max(1, now - swipe.lastTime);
      swipe.velocityY = (event.clientY - swipe.lastY) / elapsed;
      swipe.lastY = event.clientY;
      swipe.lastTime = now;
      swipe.panel.style.transform = `translateY(${Math.max(0, deltaY)}px)`;
    }, { passive: false });

    const finishFilterSheetSwipe = (event) => {
      const swipe = filterSheetSwipe;
      if (!swipe || event.pointerId !== swipe.pointerId) return;
      filterSheetSwipe = null;
      if (!swipe.dragging) return;

      const deltaY = event.clientY - swipe.startY;
      const dismissThreshold = Math.max(88, swipe.panel.getBoundingClientRect().height * 0.18);
      const shouldDismiss = deltaY >= dismissThreshold || (deltaY >= 52 && swipe.velocityY >= 0.65);

      if (shouldDismiss) {
        swipe.panel.style.removeProperty('transform');
        swipe.drawer.close();
        return;
      }

      swipe.panel.style.transition = 'transform 180ms ease-out';
      swipe.panel.style.transform = 'translateY(0px)';
      window.setTimeout(() => {
        swipe.panel.style.removeProperty('transition');
        swipe.panel.style.removeProperty('transform');
      }, 200);
    };

    document.addEventListener('pointerup', finishFilterSheetSwipe);
    document.addEventListener('pointercancel', finishFilterSheetSwipe);
  }

  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

{% assign catalog_title = collection.title %}
{% if collection.handle == 'all' %}
  {% assign catalog_title = 'catalog.store_title' | t %}
{% endif %}

{% assign catalog_hero_image = section.settings.catalog_hero_image | default: collection.image | default: collection.featured_image %}
<section class="catalog-hero" aria-labelledby="catalog-heading-{{ section.id }}">
  {% if catalog_hero_image != blank %}
    <div class="catalog-hero__background" aria-hidden="true">
      {{ catalog_hero_image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1900, 2400', sizes: '100vw', alt: '' }}
    </div>
  {% endif %}
  <div class="catalog-hero__content">
    <h1 id="catalog-heading-{{ section.id }}" class="hero__home-heading"><span>{{ catalog_title | escape }}</span></h1>
    {% if collection.description != blank %}
      <p class="hero__home-description">{{ collection.description | strip_html | strip | escape }}</p>
    {% else %}
      <p class="hero__home-description">{{ 'catalog.hero_description' | t }}</p>
    {% endif %}
    <ul class="catalog-promises hero__home-features" role="list">
      <li class="hero__home-feature">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 4.5c-7.6 0-13 3.8-13 10.1 0 2.4 1.6 4.1 3.8 4.1 6.1 0 9.2-6.8 9.2-14.2ZM5 21c2.2-5.4 5.6-8.9 10.1-11.4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span>{{ 'catalog.promise_fresh' | t }}</span>
      </li>
      <li class="hero__home-feature">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8.3 4.7v8.7L12 21l-8.3-4.6V7.7L12 3Zm0 9.2L3.7 7.7M12 12.2l8.3-4.5M12 12.2V21" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
        <span>{{ 'catalog.promise_natural' | t }}</span>
      </li>
      <li class="hero__home-feature">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><circle cx="7" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="18" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        <span>{{ 'catalog.promise_delivery' | t }}</span>
      </li>
      <li class="hero__home-feature">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v5.5c0 4.8-3.3 7.8-8 9.5-4.7-1.7-8-4.7-8-9.5V6l8-3Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/><path d="m8.5 11.8 2.2 2.2 4.8-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
        <span>{{ 'catalog.promise_better' | t }}</span>
      </li>
    </ul>
  </div>
</section>

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<collection-component view-event-payload="{{ collection | standard_event_data: 'view' | escape }}">
  <results-list
    class="section product-grid-container{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
    infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper collection-wrapper--catalog grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% assign products_per_page = 8 %}

      {% if section.settings.enable_infinite_scroll == false %}
        {% assign products_per_page = section.settings.products_per_page | default: 8 %}
      {% endif %}

      {% paginate collection.products by products_per_page %}
        {% capture children %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% content_for 'block',
                type: '_product-card',
                id: 'product-card',
                closest.product: product,
                product_view_context: 'collection'
              %}
            </li>
          {% endfor %}
        {% endcapture %}

        {% render 'product-grid',
          section: section,
          children: children,
          products: collection.products,
          paginate: paginate,
          enable_infinite_scroll: section.settings.enable_infinite_scroll
        %}

      {% endpaginate %}
    </div>
  </results-list>
</collection-component>
{% render 'freshomill-benefit-strip', context: 'store' %}

{% stylesheet %}
  .catalog-hero {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--freshomill-hero-desktop-height);
    min-height: 0;
    margin-block-start: 6px;
    overflow: hidden;
    background: var(--freshomill-color-hero);
    color: var(--freshomill-color-ink);
  }
  .catalog-hero__background,
  .catalog-hero__background::after,
  .catalog-hero__background img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .catalog-hero__background { z-index: 0; }
  .catalog-hero__background::after {
    content: '';
    background: linear-gradient(90deg, rgb(245 240 227 / 96%) 0%, rgb(245 240 227 / 85%) 36%, rgb(245 240 227 / 30%) 72%, rgb(245 240 227 / 12%) 100%);
  }
  .catalog-hero__background img { display: block; object-fit: cover; object-position: center; }
  .catalog-hero__content {
    position: relative;
    z-index: 1;
    width: 56%;
    padding: clamp(16px, 2.5vw, 36px) 0 clamp(14px, 2vw, 24px) var(--freshomill-page-gutter);
  }
  .catalog-hero .hero__home-heading { max-width: 590px; }
  .catalog-hero .hero__home-description { max-width: 460px; }
  .catalog-hero .catalog-promises { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 10px 0 0; padding: 0; list-style: none; }
  .catalog-hero .catalog-promises li { flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 5px; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); line-height: 1.2; }

  .collection-wrapper--catalog {
    column-gap: 14px;
    row-gap: 8px;
    padding-inline: clamp(8px, 1vw, 16px);
    margin-block-start: 6px;
  }
  .collection-wrapper--catalog > .facets--horizontal.facets-controls-wrapper { display: none; }
  .collection-wrapper--catalog > .facets-block-wrapper--vertical { grid-column: 1 / var(--facets-vertical-col-width); grid-row: 1 / span 2; margin: 0; }
  .collection-wrapper--catalog > .facets-toggle { grid-column: 1; }
  .collection-wrapper--catalog > .main-collection-grid { min-width: 0; padding-inline: 0; }
  .catalog-filter-links { padding: 0 0 var(--freshomill-space-3); border-bottom: 1px solid var(--freshomill-color-border); }
  .catalog-filter-links__title { display: block; margin: 0 0 7px; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 700; }
  .catalog-filter-links__list { display: grid; gap: 3px; }
  .catalog-category { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 7px; min-height: var(--freshomill-touch-target); padding: 4px 6px; border-radius: var(--freshomill-radius-control); color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); line-height: 1.2; text-decoration: none; transition: background-color .16s ease, color .16s ease; }
  .catalog-category > span:nth-child(2) { overflow: visible; text-overflow: clip; white-space: normal; }
  .catalog-category:hover, .catalog-category:focus-visible { background: var(--freshomill-color-brand-soft); color: var(--freshomill-color-brand-strong); }
  .catalog-category.is-active { background: var(--freshomill-color-brand); color: var(--freshomill-color-surface); }
  .catalog-category__icon { display: grid; width: 22px; height: 22px; place-items: center; font-size: var(--freshomill-font-size-body); text-align: center; }
  .catalog-category__icon img,
  .catalog-category__icon svg { display: block; width: 20px; height: 20px; object-fit: contain; }
  .catalog-category__icon img { display: block; width: 22px; height: 22px; border-radius: 3px; object-fit: contain; }
  .catalog-category__count { display: block; min-width: 0; height: auto; border-radius: 0; background: transparent; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); line-height: 1.2; }
  .collection-wrapper--catalog .product-grid { --product-grid-gap-mobile: 10px 8px; --product-grid-gap-desktop: 14px 8px; }
  .collection-wrapper--catalog .product-grid__item[hidden] { display: none !important; }
  .collection-wrapper--catalog .pagination:not(.catalog-pagination)[hidden] { display: none !important; }
  .collection-wrapper--catalog .product-card__content {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    box-sizing: border-box;
    height: 100%;
    min-height: 100%;
    gap: 8px !important;
    padding: 8px !important;
    overflow: hidden;
    border: 1px solid var(--freshomill-color-border);
    border-radius: var(--freshomill-radius-card);
    background: var(--freshomill-color-surface);
  }
  .collection-wrapper--catalog .product-card__content > * { min-width: 0; }
  .collection-wrapper--catalog product-card { display: block; height: 100%; min-width: 0; }
  .collection-wrapper--catalog .card-gallery {
    width: 100%;
    aspect-ratio: 1 / 1;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: var(--freshomill-radius-control);
    background: var(--freshomill-color-surface);
  }
  .collection-wrapper--catalog .card-gallery .product-media-container { --product-media-fit: contain !important; }
  .collection-wrapper--catalog .product-card__content > a.contents {
    display: block;
    width: 100%;
    min-height: 2.5em;
    color: var(--freshomill-color-ink);
    text-decoration: none;
  }
  .collection-wrapper--catalog .product-card__content > a.contents :is(.text-block, p) {
    color: var(--freshomill-color-ink);
    font-size: var(--freshomill-font-size-caption);
    font-weight: 600;
    line-height: 1.2;
  }
  .collection-wrapper--catalog .product-card__content > a.contents p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .collection-wrapper--catalog .product-card__content product-price { display: block; width: 100%; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-small); line-height: 1.2; }
  .collection-wrapper--catalog .product-card__content product-price :is(.price, .price-item__group) { color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-small); font-weight: 750; line-height: 1.2; }
  .collection-wrapper--catalog .product-card__content product-price .compare-at-price { margin-inline-start: 4px; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); font-weight: 400; text-decoration: line-through; }
  .collection-wrapper--catalog .product-card__content product-price .unit-price { display: block; margin-top: 2px; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); font-weight: 400; }
  .collection-wrapper--catalog .product-card__content > quick-add-component.quick-add {
    position: relative !important;
    inset: auto !important;
    z-index: 2;
    display: flex !important;
    width: 100% !important;
    height: var(--freshomill-touch-target) !important;
    min-height: var(--freshomill-touch-target) !important;
    margin-top: auto !important;
    flex: 0 0 var(--freshomill-touch-target) !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }
  .collection-wrapper--catalog .product-card__content > quick-add-component :is(.quick-add__product-form-component, form, .quick-add__button) { width: 100% !important; max-width: 100% !important; height: var(--freshomill-touch-target) !important; min-height: var(--freshomill-touch-target) !important; }
  .collection-wrapper--catalog .product-card__content > quick-add-component .quick-add__button {
    position: relative !important;
    inset: auto !important;
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: none !important;
  }
  .collection-wrapper--catalog .product-badges { display: none; }
  .collection-wrapper--catalog .quick-add__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 5px;
    border: 1px solid var(--freshomill-color-border);
    border-radius: var(--freshomill-radius-control);
    background: var(--freshomill-color-surface);
    color: var(--freshomill-color-brand-strong);
    font-size: var(--freshomill-font-size-caption);
    font-weight: 650;
    line-height: 1;
  }
  .collection-wrapper--catalog .quick-add__button:hover { border-color: var(--freshomill-color-brand-hover); background: var(--freshomill-color-brand-soft); }
  .collection-wrapper--catalog .quick-add__button--add { font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .quick-add__button .svg-wrapper { width: 12px; height: 12px; flex: 0 0 12px; }
  .collection-wrapper--catalog .quick-add__button .svg-wrapper svg { width: 100%; height: 100%; }
  .collection-wrapper--catalog .pagination { --pagination-size: var(--freshomill-touch-target); --pagination-inset: 0px; padding: 16px 8px; margin-top: 8px; }
  .collection-wrapper--catalog .pagination__list { gap: 4px; }
  .collection-wrapper--catalog .pagination__item { width: var(--pagination-size); height: var(--pagination-size); aspect-ratio: auto; }
  .collection-wrapper--catalog .pagination__link { border: 1px solid transparent; border-radius: var(--freshomill-radius-control); color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .pagination__link[aria-current='page'] { border-color: var(--freshomill-color-brand); background: var(--freshomill-color-brand); color: var(--freshomill-color-surface); }
  .collection-wrapper--catalog .pagination__link[aria-current='page']::before,
  .collection-wrapper--catalog .pagination__list::before { display: none; }
  .collection-wrapper--catalog .pagination__link:hover:not([aria-current='page'], .pagination__link--gap, .pagination__link--disabled) { border-color: var(--freshomill-color-border); background: var(--freshomill-color-brand-soft); color: var(--freshomill-color-brand); }
  .collection-wrapper--catalog .pagination__link--disabled { color: var(--freshomill-color-muted); }
  .collection-wrapper--catalog .facets--vertical {
    --facets-form-horizontal-gap: 0;
    padding: 0;
    color: var(--freshomill-color-ink);
    font-size: var(--freshomill-font-size-caption);
  }
  .collection-wrapper--catalog .facets--vertical .facets__form,
  .collection-wrapper--catalog .facets--vertical .facets__form-wrapper { width: 100%; }
  .collection-wrapper--catalog .facets--vertical .facets__filters-wrapper { display: grid; gap: 0; margin: 0; }
  .collection-wrapper--catalog .facets--vertical .facets__panel { border: 0; border-bottom: 1px solid var(--freshomill-color-border); }
  .collection-wrapper--catalog .facets--vertical .facets__summary { min-height: 40px; padding: 4px 1px; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 650; }
  .collection-wrapper--catalog .facets--vertical .facets__inputs-wrapper { margin-block: 0 4px; padding: 0 0 4px; }
  .collection-wrapper--catalog .facets--vertical .facets__inputs-list { gap: 3px; }
  .collection-wrapper--catalog .facets--vertical .facets__label { display: flex; min-height: 32px; align-items: center; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets--vertical input[type='checkbox'] { accent-color: var(--freshomill-color-brand); }
  .collection-wrapper--catalog .facets--vertical .facets__status { color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets--vertical .facets__clear-all { min-height: var(--freshomill-touch-target); border: 1px solid var(--freshomill-color-brand); border-radius: var(--freshomill-radius-control); color: var(--freshomill-color-brand); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets-block-wrapper--vertical :is(.facets__form, .facets__form-wrapper, .facets__filters-wrapper, .facets-remove) { width: 100%; min-width: 0; max-width: 100%; }
  .collection-wrapper--catalog .facets-block-wrapper--vertical .facets-remove { gap: 5px; margin: 0 0 8px; padding: 0; }
  .collection-wrapper--catalog .facets-block-wrapper--vertical .facets-remove__pill { max-width: 100%; min-width: 0; overflow-wrap: anywhere; }
  .collection-wrapper--catalog .facets-block-wrapper--vertical .facets-remove > facet-remove-component:not(.facets-remove__pill) { display: none; }
  .collection-wrapper--catalog :is(.facets--vertical, .facets--drawer) .price-facet__inputs-wrapper { flex-wrap: nowrap; gap: 6px; padding: 0; }
  .collection-wrapper--catalog :is(.facets--vertical, .facets--drawer) .price-facet__field { min-width: 0; min-height: var(--freshomill-touch-target); }
  .collection-wrapper--catalog :is(.facets--vertical, .facets--drawer) .price-facet__input { height: var(--freshomill-touch-target); min-height: var(--freshomill-touch-target); padding-block: 4px; font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog :is(.facets--vertical, .facets--drawer) .price-facet__label { top: 50%; display: flex; height: auto; align-items: center; padding: 0 8px; transform: translateY(-50%); font-size: var(--freshomill-font-size-caption); line-height: 1; }
  .collection-wrapper--catalog :is(.facets--vertical, .facets--drawer) .price-facet__highest-price { padding: 2px 0 4px; font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets--vertical .facets-remove .facets__clear-all-link { display: none; }
  .collection-wrapper--catalog .catalog-clear-filters { display: block; width: 100%; margin-block-start: 10px; }
  .collection-wrapper--catalog .catalog-clear-filters button { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; min-height: var(--freshomill-touch-target); padding: 5px 10px; border: 1px solid var(--freshomill-color-brand); border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-surface); color: var(--freshomill-color-brand); box-shadow: none; font-size: var(--freshomill-font-size-caption); font-weight: 600; line-height: 1.2; }
  .collection-wrapper--catalog .catalog-clear-filters button svg { width: 13px; height: 13px; flex: 0 0 13px; }
  .collection-wrapper--catalog .catalog-clear-filters button:hover { background: var(--freshomill-color-brand-soft); }
  .collection-wrapper--catalog .products-count-wrapper { margin: 0; font-size: var(--freshomill-font-size-caption); font-weight: 650; }
  .collection-wrapper--catalog .catalog-mobile-products-count { display: none; }
  .collection-wrapper--catalog .sorting-filter__container { gap: 5px; }
  .collection-wrapper--catalog .sorting-filter__select { min-height: var(--freshomill-touch-target); padding: 4px 24px 4px 8px; border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-surface); color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets-toggle__button { min-height: var(--freshomill-touch-target); padding: 6px 10px; border: 1px solid var(--freshomill-color-brand); border-radius: var(--freshomill-radius-control); color: var(--freshomill-color-brand); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets--drawer .facets__summary { font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets--drawer input[type='checkbox'] { accent-color: var(--freshomill-color-brand); }
  .collection-wrapper--catalog .facets__drawer-actions { gap: 7px; padding: 10px 12px max(12px, env(safe-area-inset-bottom)); }
  .collection-wrapper--catalog .facets__drawer-actions button { min-height: var(--freshomill-touch-target); border-radius: var(--freshomill-radius-control); font-size: var(--freshomill-font-size-caption); }
  .collection-wrapper--catalog .facets__drawer-actions .facets__clear-all { display: flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid var(--freshomill-color-brand); background: var(--freshomill-color-surface); color: var(--freshomill-color-brand); box-shadow: none; font-size: var(--freshomill-font-size-caption); font-weight: 600; }
  .collection-wrapper--catalog .facets__drawer-actions .facets__clear-all svg { width: 14px; height: 14px; flex: 0 0 14px; }
  .collection-wrapper--catalog .facets__see-results { background: var(--freshomill-color-brand); border-color: var(--freshomill-color-brand); }
  .collection-wrapper--catalog .product-card { row-gap: 2px; }
  .collection-wrapper--catalog .product-title { font-size: var(--freshomill-font-size-caption); line-height: 1.25; }
  .collection-wrapper--catalog .price { font-size: .82rem; font-weight: 650; }

  @media screen and (max-width: 749px) {
    .catalog-hero { height: var(--freshomill-hero-mobile-height); min-height: 0; }
    .catalog-hero__content { width: 84%; padding: var(--freshomill-space-2) var(--freshomill-page-gutter); }
    .catalog-hero .hero__home-heading { font-size: clamp(18px, 5.2vw, 25px); }
    .catalog-hero .hero__home-description { display: -webkit-box; margin-block-start: 6px; overflow: hidden; font-size: clamp(12px, 3vw, 14px); line-height: 1.25; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
    .catalog-hero .catalog-promises { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 8px; margin-block-start: 6px; }
    .catalog-hero .catalog-promises li { gap: 3px; padding: 0; font-size: var(--freshomill-font-size-caption); }
    .collection-wrapper--catalog { display: block; padding-inline: var(--freshomill-page-gutter); }
    .collection-wrapper--catalog > .main-collection-grid { padding: 0; }
    .collection-wrapper--catalog .product-grid { --product-grid-gap-mobile: 10px 8px; }
    .collection-wrapper--catalog .product-grid,
    .collection-wrapper--catalog .product-grid[product-grid-view='mobile-single'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .collection-wrapper--catalog .product-grid__item { min-width: 0; }
    .collection-wrapper--catalog .product-card__content { box-sizing: border-box; gap: 4px !important; padding: 8px !important; border-radius: var(--freshomill-radius-card); }
    .collection-wrapper--catalog .card-gallery { width: 100%; margin: 0 !important; }
    .collection-wrapper--catalog .product-card__content > a.contents :is(.text-block, p) { font-size: var(--freshomill-font-size-caption); }
    .collection-wrapper--catalog .product-card__content product-price,
    .collection-wrapper--catalog .product-card__content product-price :is(.price, .price-item__group) { font-size: var(--freshomill-font-size-caption); }
    .collection-wrapper--catalog .product-card__content product-price :is(.compare-at-price, .unit-price) { font-size: var(--freshomill-font-size-caption); }
    .collection-wrapper--catalog .product-card__content > quick-add-component.quick-add,
    .collection-wrapper--catalog .product-card__content > quick-add-component :is(.quick-add__product-form-component, form, .quick-add__button) { height: var(--freshomill-touch-target) !important; min-height: var(--freshomill-touch-target) !important; }
    .collection-wrapper--catalog .quick-add__button { font-size: var(--freshomill-font-size-caption); }
    .collection-wrapper--catalog .pagination { --pagination-size: var(--freshomill-touch-target); padding: 12px 2px; }
    .collection-wrapper--catalog > .facets-block-wrapper--vertical:not(#filters-drawer) { display: none; }
    .collection-wrapper--catalog > .facets-toggle { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; align-items: center; column-gap: var(--freshomill-space-3); row-gap: var(--freshomill-space-1); height: auto; min-height: 0; margin: 0 0 var(--freshomill-space-3); padding: 0; }
    .collection-wrapper--catalog .facets-mobile-wrapper { display: flex; grid-column: 2; grid-row: 1; justify-self: end; flex: 0 0 auto; }
    .collection-wrapper--catalog .catalog-mobile-products-count { display: block; flex: 1 1 auto; min-width: 0; color: var(--freshomill-color-ink); font-size: clamp(12px, 3.2vw, 13px); font-weight: 600; line-height: 1.2; white-space: nowrap; }
    .collection-wrapper--catalog .catalog-mobile-products-count { grid-column: 1; grid-row: 1; }
    .collection-wrapper--catalog .facets-toggle__wrapper { grid-column: 1 / -1; grid-row: 2; width: 100%; margin: 0; }
    .collection-wrapper--catalog .facets-toggle__button { position: relative; display: flex; align-items: center; justify-content: flex-start; gap: 8px; width: 100%; min-width: 0; min-height: var(--freshomill-touch-target); overflow: visible; padding: 8px 40px 8px 12px; border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-card); background: var(--freshomill-color-surface); color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-small); font-weight: 600; line-height: 1.2; text-align: start; }
    .collection-wrapper--catalog .facets-toggle__category { min-width: 0; overflow: hidden; color: var(--freshomill-color-muted); font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
    .collection-wrapper--catalog .facets-toggle__category[hidden] { display: none; }
    .collection-wrapper--catalog .facets-toggle__button > .svg-wrapper,
    .collection-wrapper--catalog .facets-toggle__button > .svg-wrapper svg { display: block; width: 19px; height: 19px; flex: 0 0 19px; }
    .collection-wrapper--catalog .facets-toggle__button .filter-count-bubble { box-sizing: border-box; display: grid; position: absolute; top: 50%; inset-inline-end: 10px; width: 20px; min-width: 20px; height: 20px; place-items: center; margin: 0; padding: 0; border: 0; border-radius: 50%; color: var(--freshomill-color-surface); font-size: 10px; line-height: 1; transform: translateY(-50%); }
    .collection-wrapper--catalog .facets-toggle__button .filter-count-bubble__background { grid-area: 1 / 1; width: 100%; height: 100%; background: var(--freshomill-color-brand); border-radius: 50%; }
    .collection-wrapper--catalog .facets-toggle__button .filter-count-bubble__text { grid-area: 1 / 1; z-index: 1; display: block; position: relative; min-width: 0; height: auto; aspect-ratio: auto; margin: 0; padding: 0; color: var(--freshomill-color-surface); font-size: 10px; font-weight: 700; line-height: 1; text-align: center; }
    .collection-wrapper--catalog .facets-mobile-wrapper sorting-filter-component { width: auto; flex: 0 0 auto; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter__container { display: none !important; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter { position: relative; z-index: auto; width: 100%; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter:has(.facets__panel[open]) { z-index: 2; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter .facets__panel { border: 0; border-radius: 0; background: transparent; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter .facets__summary { display: flex; min-height: var(--freshomill-touch-target); align-items: center; justify-content: flex-start; gap: 5px; padding: 6px 2px; border: 0; background: transparent; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-small); font-weight: 500; line-height: 1; white-space: nowrap; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter .facets__summary .facets__status { display: none; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter .facets__summary .svg-wrapper { width: 14px; height: 14px; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter .facets__summary svg { width: 14px; height: 14px; }
    .collection-wrapper--catalog .facets-mobile-wrapper .sorting-filter__options { z-index: 20; min-width: 130px; font-size: var(--freshomill-font-size-caption); }
    .collection-wrapper--catalog .product-card { row-gap: 1px; }
    #filters-drawer .theme-drawer__dialog {
      position: fixed;
      inset: auto 0 -100% !important;
      width: 100%;
      max-width: none;
      max-height: min(86dvh, 720px);
      height: auto;
      margin: 0;
      padding: 0;
      border: 0;
      border-radius: var(--freshomill-radius-panel) var(--freshomill-radius-panel) 0 0;
      overflow: hidden;
      box-shadow: 0 -12px 40px rgb(0 0 0 / .16);
      animation: none;
      transition: none;
    }
    #filters-drawer .theme-drawer__dialog[open] { inset: auto 0 0 !important; }
    #filters-drawer .theme-drawer__dialog--opening { animation: catalog-sheet-in .24s ease-out; }
    #filters-drawer .theme-drawer__dialog--closing { animation: catalog-sheet-out .2s ease-in forwards; }
    #filters-drawer .theme-drawer__header { position: relative; padding: 20px var(--freshomill-page-gutter) 12px; border: 0; touch-action: pan-x; }
    #filters-drawer .theme-drawer__header::before { position: absolute; top: 7px; left: 50%; width: 36px; height: 4px; border-radius: 999px; background: var(--freshomill-color-border); content: ''; transform: translateX(-50%); }
    #filters-drawer .facets-drawer__filters { max-height: none; overflow: auto; padding: var(--freshomill-space-4) var(--freshomill-page-gutter) max(var(--freshomill-space-4), env(safe-area-inset-bottom)); }
    #filters-drawer .catalog-filter-links > .catalog-filter-links__title { margin: 0 0 8px; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 700; }
    #filters-drawer .catalog-filter-links { margin-bottom: var(--freshomill-space-4); padding-bottom: 0; border: 0; }
    #filters-drawer .catalog-filter-links__list { gap: 4px; }
    #filters-drawer .catalog-category { min-height: 72px; padding: 7px; font-size: var(--freshomill-font-size-caption); }
    #filters-drawer .catalog-category__icon,
    #filters-drawer .catalog-category__icon img { width: 24px; height: 24px; }
    #filters-drawer .catalog-category__count { display: block; min-width: 0; height: auto; border-radius: 0; background: transparent; color: var(--freshomill-color-muted); font-size: 10px; line-height: 1.2; }
    #filters-drawer .facets--drawer .facets__filters-wrapper { display: grid; gap: 9px; }
    #filters-drawer .facets--drawer .facets__panel { border: 0; }
    #filters-drawer .facets--drawer .facets__summary { min-height: var(--freshomill-touch-target); padding: 6px 1px; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 650; }
    #filters-drawer .facets--drawer .facets__summary,
    #filters-drawer .facets--drawer .facets__inputs-wrapper { border: 0; box-shadow: none; }
    #filters-drawer .facets--drawer .facets__inputs-wrapper { margin-block: 0 5px; padding: 2px 0 4px; }
    #filters-drawer .facets--drawer .facets__inputs-list { gap: 4px; }
    #filters-drawer .facets--drawer .facets__label { color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); }
    #filters-drawer .facets--drawer .facets__status { color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); }
    #filters-drawer .facets__drawer-actions,
    #filters-drawer .facets__drawer-actions:has(.catalog-clear-all) { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: var(--freshomill-space-2); padding: var(--freshomill-space-3) var(--freshomill-page-gutter) max(var(--freshomill-space-4), env(safe-area-inset-bottom)); border: 0; box-shadow: none; }
    #filters-drawer .facets__drawer-actions :is(.catalog-apply-filters, .catalog-clear-all) { display: flex; width: 100%; height: var(--freshomill-touch-target); min-height: var(--freshomill-touch-target); align-items: center; justify-content: center; gap: 6px; margin: 0; padding: 8px 10px; border-radius: var(--freshomill-radius-control); font-size: var(--freshomill-font-size-caption); font-weight: 650; }
    #filters-drawer .facets__drawer-actions .catalog-apply-filters { border: 1px solid var(--freshomill-color-brand); background: var(--freshomill-color-brand); color: var(--freshomill-color-surface); }
    #filters-drawer .facets__drawer-actions .catalog-clear-all { border: 1px solid var(--freshomill-color-brand); background: var(--freshomill-color-surface); color: var(--freshomill-color-brand); }
    #filters-drawer .facets__drawer-actions :is(.catalog-apply-filters, .catalog-clear-all):disabled { cursor: not-allowed; opacity: .48; }
  }

  @media screen and (min-width: 750px) {
    results-list.section.product-grid-container:has(.collection-wrapper--catalog) {
      grid-column: 1 / -1 !important;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      max-width: none;
      justify-self: stretch;
      --padding-block-start: 0px;
    }
    results-list.section.product-grid-container:has(.collection-wrapper--catalog) > .collection-wrapper--catalog {
      grid-column: 1 / -1;
      width: 100%;
      max-width: none;
    }
    .collection-wrapper--catalog.grid {
      --catalog-sidebar-track: minmax(240px, min(25vw, 375px));
      grid-template-columns: var(--catalog-sidebar-track) minmax(0, 1fr);
      grid-template-rows: 38px auto;
      column-gap: 14px;
      row-gap: 8px;
      width: 100%;
      max-width: none;
      align-items: start;
    }
    .collection-wrapper--catalog > .facets--horizontal.facets-controls-wrapper {
      display: grid;
      grid-template-columns: var(--catalog-sidebar-track) minmax(0, 1fr);
      column-gap: 14px;
      grid-column: 1 / -1;
      grid-row: 1;
      align-items: center;
      min-height: 38px;
      margin: 0;
      padding: 0;
      font-size: var(--freshomill-font-size-caption);
      line-height: 1.3;
      position: relative;
      z-index: auto;
      overflow: visible;
      --facets-upper-z-index: 121;
      --facets-open-z-index: 122;
    }
    .collection-wrapper--catalog .catalog-desktop-search-title { grid-column: 1; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 700; line-height: 1.25; }
    .collection-wrapper--catalog .catalog-desktop-results-controls { grid-column: 2; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; min-height: var(--freshomill-touch-target); }
    .collection-wrapper--catalog .catalog-desktop-results-controls .products-count-wrapper { margin-inline-start: 0; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 600; line-height: 1.25; white-space: nowrap; }
    .collection-wrapper--catalog .catalog-desktop-results-controls sorting-filter-component { flex: 0 0 auto; margin-inline-start: auto; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .sorting-filter { position: relative; z-index: auto; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .sorting-filter:has(.facets__panel[open]) { z-index: 2; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .products-count-wrapper { height: var(--freshomill-touch-target); }
    .collection-wrapper--catalog .catalog-desktop-results-controls .facets__summary { min-height: var(--freshomill-touch-target); padding: 2px 4px; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); line-height: 1.25; }
    .collection-wrapper--catalog .facets-block-wrapper--vertical:not(#filters-drawer) {
      display: grid;
      grid-template-rows: var(--freshomill-touch-target) auto;
      align-content: start;
      row-gap: 8px;
      padding-block-start: 0;
      --facets-margin: 0;
    }
    .collection-wrapper--catalog .facets-block-wrapper--vertical:not(#filters-drawer) > .catalog-filter-links { display: contents; }
    .collection-wrapper--catalog .facets-block-wrapper--vertical:not(#filters-drawer) .catalog-filter-links__title {
      grid-row: 1;
      align-self: center;
      margin: 0;
      line-height: 1.25;
    }
    .collection-wrapper--catalog .facets-block-wrapper--vertical:not(#filters-drawer) .catalog-filter-links__list { grid-row: 2; }
    .collection-wrapper--catalog .facets-block-wrapper--vertical { --facets-margin: 0; }
    .collection-wrapper--catalog > .main-collection-grid {
      display: block;
      width: 100%;
      max-width: none;
      min-width: 0;
      grid-column: 2 / -1;
      grid-row: 2;
      padding-block-start: 0;
    }
    .collection-wrapper--catalog > #ResultsList {
      display: block !important;
      flex: 1 1 auto;
      width: 100% !important;
      inline-size: 100% !important;
      max-width: none !important;
      max-inline-size: none !important;
      justify-self: stretch !important;
      grid-column: 2 / -1 !important;
      grid-row: 2 !important;
    }
    .collection-wrapper--catalog > #ResultsList > div { width: 100%; inline-size: 100%; max-width: none; }
    .collection-wrapper--catalog > #ResultsList .product-grid {
      display: grid;
      width: 100%;
      inline-size: 100%;
      max-width: none;
      min-width: 0;
      gap: 16px;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .collection-wrapper--catalog .product-grid__item,
    .collection-wrapper--catalog product-card { width: 100%; min-width: 0; }
    .collection-wrapper--catalog .facets--filters-title { display: none; }
    @media screen and (max-width: 1439px) {
      .collection-wrapper--catalog.grid { --catalog-sidebar-track: minmax(220px, min(25vw, 375px)); }
      .collection-wrapper--catalog > #ResultsList .product-grid {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
      }
    }
  }

  @keyframes catalog-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @keyframes catalog-sheet-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "catalog_hero_image",
      "label": "Catalog hero image"
    },
    {
      "type": "collection_list",
      "id": "catalog_categories",
      "label": "Catalog categories",
      "limit": 12
    },
    {
      "type": "select",
      "id": "quick_add_position",
      "label": "Quick add position",
      "options": [
        { "value": "overlay", "label": "On product image" },
        { "value": "below", "label": "Below product details" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 2,
      "default": 8,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
