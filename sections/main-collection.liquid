  .collection-wrapper--catalog .facets__drawer-actions button { min-height: 36px; border-radius: 4px; font-size: 12px; }
  .collection-wrapper--catalog .facets__drawer-actions .facets__clear-all { display: flex; align-items: center; justify-content: center; gap: 6px; border: 1px solid #176b1c; background: #fff; color: #176b1c; box-shadow: none; font-size: 11px; font-weight: 600; }
  .collection-wrapper--catalog .facets__drawer-actions .facets__clear-all svg { width: 14px; height: 14px; flex: 0 0 14px; }
  .collection-wrapper--catalog .facets__see-results { background: #176b1c; border-color: #176b1c; }
  .collection-wrapper--catalog .product-card { row-gap: 2px; }
  .collection-wrapper--catalog .product-title { font-size: .72rem; line-height: 1.25; }
  .collection-wrapper--catalog .price { font-size: .82rem; font-weight: 650; }

  @media screen and (max-width: 749px) {
    .catalog-hero { aspect-ratio: 2.1 / 1; max-height: 180px; min-height: 0; }
    .catalog-hero__content { width: 60%; padding: 10px 0 8px 8px; }
    .catalog-hero .hero__home-heading { font-size: clamp(18px, 5.2vw, 25px); }
    .catalog-hero .hero__home-description { margin-block-start: 6px; font-size: clamp(9px, 2.65vw, 12px); line-height: 1.25; }
    .catalog-hero .catalog-promises { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; margin-block-start: 6px; }
    .catalog-hero .catalog-promises li { gap: 3px; padding: 0; font-size: clamp(7px, 1.95vw, 9px); }
    .collection-wrapper--catalog { display: block; padding-inline: 10px; }
    .collection-wrapper--catalog > .main-collection-grid { padding: 0; }
    .collection-wrapper--catalog .product-grid { --product-grid-gap-mobile: 10px 8px; }
    .collection-wrapper--catalog .product-grid,
    .collection-wrapper--catalog .product-grid[product-grid-view='mobile-single'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .collection-wrapper--catalog .product-grid__item { min-width: 0; }
    .collection-wrapper--catalog .product-card__content { box-sizing: border-box; gap: 4px !important; padding: 8px !important; border-radius: 7px; }
    .collection-wrapper--catalog .card-gallery { width: 100%; margin: 0 !important; }
    .collection-wrapper--catalog .product-card__content > a.contents :is(.text-block, p) { font-size: 9px; }
    .collection-wrapper--catalog .product-card__content product-price,
    .collection-wrapper--catalog .product-card__content product-price :is(.price, .price-item__group) { font-size: 11px; }
    .collection-wrapper--catalog .product-card__content product-price :is(.compare-at-price, .unit-price) { font-size: 8px; }
    .collection-wrapper--catalog .product-card__content > quick-add-component.quick-add,
    .collection-wrapper--catalog .product-card__content > quick-add-component :is(.quick-add__product-form-component, form, .quick-add__button) { height: 26px !important; min-height: 26px !important; }
    .collection-wrapper--catalog .quick-add__button { font-size: 9px; }
    .collection-wrapper--catalog .quick-add__button--add::after { font-size: 9px; }
    .collection-wrapper--catalog .pagination { --pagination-size: 30px; padding: 12px 2px; }
    .collection-wrapper--catalog > .facets-block-wrapper--vertical:not(#filters-drawer) { display: none; }
    .collection-wrapper--catalog > .facets-toggle { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 8px; padding: 0; }
    .collection-wrapper--catalog .facets-mobile-wrapper { display: flex; flex: 0 0 auto; }
    .collection-wrapper--catalog .catalog-mobile-products-count { display: block; flex: 1 1 auto; color: #34473a; font-size: 10px; font-weight: 600; white-space: nowrap; }
    .collection-wrapper--catalog .catalog-mobile-products-count { order: 1; }
    .collection-wrapper--catalog .facets-toggle__wrapper { order: 2; }
    .collection-wrapper--catalog .facets-mobile-wrapper { order: 3; }
    .collection-wrapper--catalog .sorting-filter__select { width: 112px; max-width: 112px; text-align: left; text-align-last: left; }
    .collection-wrapper--catalog .facets-toggle__button .filter-count-bubble { display: grid; position: static; width: 15px; min-width: 15px; height: 15px; margin-inline-start: 1px; font-size: 9px; }
    .collection-wrapper--catalog .facets-toggle__button { display: inline-flex; align-items: center; justify-content: center; gap: 4px; width: auto; min-width: 58px; min-height: 34px; padding: 6px 8px; font-size: 10px; white-space: nowrap; }
    .collection-wrapper--catalog .product-card { row-gap: 1px; }
    #filters-drawer .theme-drawer__dialog {
      position: fixed;
      inset: auto 0 -100% !important;
      width: 100%;
      max-width: none;
      max-height: min(86dvh, 720px);
      height: auto;
      margin: 0;
      padding: 0 0 env(safe-area-inset-bottom);
      border: 0;
      border-radius: 14px 14px 0 0;
      overflow: hidden;
      box-shadow: 0 -12px 40px rgb(0 0 0 / .16);
      animation: none;
      transition: none;
    }
    #filters-drawer .theme-drawer__dialog[open] { inset: auto 0 0 !important; }
    #filters-drawer .theme-drawer__dialog--opening { animation: catalog-sheet-in .24s ease-out; }
    #filters-drawer .theme-drawer__dialog--closing { animation: catalog-sheet-out .2s ease-in forwards; }
    #filters-drawer .theme-drawer__header { padding: 15px 14px 11px; }
    #filters-drawer .facets-drawer__filters { max-height: calc(86dvh - 118px); overflow: auto; }
    #filters-drawer .facets__drawer-actions { flex-direction: column; }
    #filters-drawer .facets__drawer-actions .facets__clear-all { display: flex; align-items: center; justify-content: center; gap: 6px; order: 2; width: 100%; min-height: 36px; padding: 0 10px; border: 1px solid #176b1c; border-radius: 4px; color: #176b1c; }
    #filters-drawer .facets__drawer-actions .facets__see-results { order: 1; width: 100%; min-height: 36px; }
  }

  @media screen and (min-width: 750px) {
    results-list.section.product-grid-container:has(.collection-wrapper--catalog) {
      grid-column: 1 / -1 !important;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      max-width: none;
      justify-self: stretch;
      --padding-block-start: 0px;
    }
    results-list.section.product-grid-container:has(.collection-wrapper--catalog) > .collection-wrapper--catalog {
      grid-column: 1 / -1;
      width: 100%;
      max-width: none;
    }
    .collection-wrapper--catalog.grid {
      grid-template-columns: minmax(240px, min(25vw, 375px)) minmax(0, 1fr);
      grid-template-rows: 38px auto;
      column-gap: 14px;
      row-gap: 8px;
      width: 100%;
      max-width: none;
      align-items: start;
    }
    .collection-wrapper--catalog > .facets--horizontal.facets-controls-wrapper {
      display: grid;
      grid-template-columns: minmax(240px, min(25vw, 375px)) minmax(0, 1fr);
      column-gap: 14px;
      grid-column: 1 / -1;
      grid-row: 1;
      align-items: center;
      min-height: 38px;
      margin: 0;
      padding: 0;
      font-size: 10px;
      line-height: 1.3;
      position: relative;
      z-index: auto;
      overflow: visible;
      --facets-upper-z-index: 121;
      --facets-open-z-index: 122;
    }
    .collection-wrapper--catalog .catalog-desktop-search-title { grid-column: 1; color: #213629; font-size: 12px; font-weight: 700; line-height: 1.25; }
    .collection-wrapper--catalog .catalog-desktop-results-controls { grid-column: 2; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; min-height: 38px; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .products-count-wrapper { margin-inline-start: 0; color: #25372b; font-size: 11px; font-weight: 600; line-height: 1.25; white-space: nowrap; }
    .collection-wrapper--catalog .catalog-desktop-results-controls sorting-filter-component { flex: 0 0 auto; margin-inline-start: auto; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .sorting-filter { position: relative; z-index: auto; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .sorting-filter:has(.facets__panel[open]) { z-index: 2; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .products-count-wrapper { height: 38px; }
    .collection-wrapper--catalog .catalog-desktop-results-controls .facets__summary { min-height: 38px; padding: 2px 4px; color: #25372b; font-size: 11px; line-height: 1.25; }
    .collection-wrapper--catalog .facets-block-wrapper--vertical { padding-block-start: 46px; }
    .collection-wrapper--catalog .catalog-filter-search .catalog-filter-links__title { display: none; }
    .collection-wrapper--catalog .facets-block-wrapper--vertical { --facets-margin: 0; }
    .collection-wrapper--catalog > .main-collection-grid {
      display: block;
      width: 100%;
      max-width: none;
      min-width: 0;
      grid-column: 2 / -1;
      grid-row: 2;
      padding-block-start: 0;
    }
    .collection-wrapper--catalog > #ResultsList {
      display: block !important;
      flex: 1 1 auto;
      width: 100% !important;
      inline-size: 100% !important;
      max-width: none !important;
      max-inline-size: none !important;
      justify-self: stretch !important;
      grid-column: 2 / -1 !important;
      grid-row: 2 !important;
    }
    .collection-wrapper--catalog > #ResultsList > div { width: 100%; inline-size: 100%; max-width: none; }
    .collection-wrapper--catalog > #ResultsList .product-grid {
      display: grid;
      width: 100%;
      inline-size: 100%;
      max-width: none;
      min-width: 0;
      gap: 16px;
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .collection-wrapper--catalog .product-grid__item,
    .collection-wrapper--catalog product-card { width: 100%; min-width: 0; }
    .collection-wrapper--catalog .facets--filters-title { display: none; }
    @media screen and (max-width: 1439px) {
      .collection-wrapper--catalog.grid { grid-template-columns: minmax(220px, min(25vw, 375px)) minmax(0, 1fr); }
      .collection-wrapper--catalog > .facets--horizontal.facets-controls-wrapper { grid-template-columns: minmax(220px, min(25vw, 375px)) minmax(0, 1fr); }
      .collection-wrapper--catalog > #ResultsList .product-grid {
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
      }
    }
  }

  @keyframes catalog-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @keyframes catalog-sheet-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "catalog_hero_image",
      "label": "Catalog hero image"
    },
    {
      "type": "collection_list",
      "id": "catalog_categories",
      "label": "Catalog categories",
      "limit": 12
    },
    {
      "type": "select",
      "id": "quick_add_position",
      "label": "Quick add position",
      "options": [
        { "value": "overlay", "label": "On product image" },
        { "value": "below", "label": "Below product details" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": false
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 2,
      "default": 10,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
