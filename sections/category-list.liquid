{% liquid
  assign categories = section.settings.collection_list
  if categories == blank
    assign categories = collections
  endif

  assign visible_category_count = 0
  if categories != blank
    for collection in categories
      if collection.handle != 'all' and collection.products_count > 0
        assign visible_category_count = visible_category_count | plus: 1
      endif
    endfor
  endif
%}

{% if visible_category_count > 0 %}
<section class="category-section" aria-labelledby="category-heading-{{ section.id }}">
  <div class="category-panel">
    <div class="category-heading-row">
      <div class="category-heading-copy">
        <p class="category-eyebrow"><span aria-hidden="true">✦</span> {{ section.settings.eyebrow | escape }}</p>
        <h2 id="category-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>

    <div class="category-track" role="group" aria-label="Shop by category">
      {% for collection in categories %}
        {% if collection.handle != 'all' and collection.products_count > 0 %}
        {% assign category_image = collection.featured_image | default: collection.image %}
        {% if category_image == blank %}
          {% assign category_image = collection.products.first.featured_image %}
        {% endif %}
        <a class="category-card" href="{{ collection.url }}" aria-label="Shop {{ collection.title | escape }}, {{ collection.products_count }} products">
          <span class="category-card__image">
            {% if category_image != blank %}
              {{ category_image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '180, 280, 420, 560', sizes: '(min-width: 750px) 17vw, 42vw', alt: collection.title }}
            {% else %}
              <span class="category-card__placeholder" aria-hidden="true">{{ collection.title | slice: 0 }}</span>
            {% endif %}
          </span>
          <span class="category-card__title">{{ collection.title | escape }}</span>
          <span class="category-card__count">{{ collection.products_count }} products</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% stylesheet %}
  .category-section {
    width: min(100%, var(--page-width, 100%));
    margin-inline: auto;
  }

  .category-panel {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--freshomill-color-brand-soft);
    padding: var(--freshomill-space-6) var(--freshomill-page-gutter);
  }

  .category-heading-row {
    margin-bottom: 12px;
  }

  .category-heading-copy {
    min-width: 0;
  }

  .category-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 4px;
    color: var(--freshomill-color-brand-strong);
    font-size: var(--freshomill-font-size-caption);
    font-weight: 650;
    line-height: 1.2;
  }

  .category-eyebrow span {
    color: var(--freshomill-color-brand);
    font-size: 16px;
  }

  .category-heading-row h2 {
    margin: 0;
    color: var(--freshomill-color-brand-deep);
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.12;
  }

  .category-track {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: 10px;
    min-width: 0;
  }

  .category-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 7px;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 90%);
    border-radius: var(--freshomill-radius-panel);
    color: var(--freshomill-color-ink);
    background: var(--freshomill-color-surface);
    text-align: center;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .category-card:hover,
  .category-card:focus-visible {
    color: var(--freshomill-color-ink);
    box-shadow: 0 5px 14px rgb(23 74 42 / 12%);
    transform: translateY(-2px);
  }

  .category-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 1.08;
    overflow: hidden;
    border-radius: var(--freshomill-radius-card);
    background: var(--freshomill-color-hero);
  }

  .category-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .category-card:hover .category-card__image img {
    transform: scale(1.04);
  }

  .category-card__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #967944;
    background: radial-gradient(ellipse at 50% 70%, #e9d7af 0 23%, transparent 24%), linear-gradient(145deg, #fbf6e9, #e9eadb);
    font-family: Georgia, serif;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1;
  }


  .category-card__title {
    display: -webkit-box;
    min-height: 0;
    margin-inline: 8px;
    overflow: hidden;
    color: var(--freshomill-color-ink);
    font-size: var(--freshomill-font-size-small);
    font-weight: 650;
    line-height: 1.15;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .category-card__count {
    display: block;
    margin-inline: 8px;
    margin-block-end: 8px;
    margin-block-start: -5px;
    color: var(--freshomill-color-muted);
    font-size: var(--freshomill-font-size-caption);
    line-height: 1.2;
  }

  @media screen and (min-width: 750px) {
    .category-card {
      width: 100%;
      max-width: 280px;
    }

    .category-card__image {
      aspect-ratio: 1.25;
    }
  }

  @media screen and (max-width: 749px) {
    .category-panel {
      padding: var(--freshomill-space-4) var(--freshomill-page-gutter);
    }

    .category-heading-row {
      margin-bottom: var(--freshomill-space-2);
    }

    .category-eyebrow {
      margin-bottom: 3px;
      font-size: var(--freshomill-font-size-caption);
    }

    .category-eyebrow span {
      font-size: var(--freshomill-font-size-small);
    }

    .category-heading-row h2 {
      max-width: 460px;
      font-size: clamp(16px, 4.8vw, 21px);
      letter-spacing: -0.04em;
    }

    .category-track {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 138px), 1fr));
      gap: var(--freshomill-space-2);
      margin-inline: 0;
      padding: 0;
    }

    .category-card {
      gap: 5px;
      padding: 0;
      border-radius: var(--freshomill-radius-card);
    }

    .category-card__image {
      aspect-ratio: 1.16;
      border-radius: var(--freshomill-radius-control);
    }

    .category-card__title {
      min-height: 0;
      margin-inline: 7px;
      font-size: var(--freshomill-font-size-caption);
      line-height: 1.12;
    }

    .category-card__count {
      margin-inline: 7px;
      margin-block-end: 7px;
      margin-block-start: -3px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "class": "category-list-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything we mill, press and pack"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Categories",
      "limit": 50
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "category": "Collections"
    }
  ]
}
{% endschema %}
