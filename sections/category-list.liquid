{% liquid
  assign categories = section.settings.collection_list
  if categories == blank
    assign categories = collections
  endif

  assign visible_category_count = 0
  if categories != blank
    for collection in categories
      if collection.handle != 'all' and collection.products_count > 0
        assign visible_category_count = visible_category_count | plus: 1
      endif
    endfor
  endif

  assign display_category_count = visible_category_count
  if display_category_count > 5
    assign display_category_count = 5
  endif
%}

{% if visible_category_count > 0 %}
{% assign visible_category_count = 0 %}
<section class="category-section" aria-labelledby="category-heading-{{ section.id }}">
  <div class="category-panel">
    <div class="category-heading-row">
      <div class="category-heading-copy">
        <p class="category-eyebrow"><span aria-hidden="true">✦</span> {{ section.settings.eyebrow | escape }}</p>
        <h2 id="category-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <a class="category-view-all" href="{{ routes.all_products_collection_url }}">
        <span>View all products</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
      </a>
    </div>

    <div class="category-carousel">
      <div class="category-track" data-category-track style="--category-count: {{ display_category_count }};" tabindex="0" aria-label="Shop by category">
        {% for collection in categories %}
          {% if collection.handle != 'all' and collection.products_count > 0 and visible_category_count < 5 %}
          {% assign category_image = collection.featured_image | default: collection.image %}
          <a class="category-card" href="{{ collection.url }}" aria-label="Shop {{ collection.title | escape }}">
            <span class="category-card__image">
              {% if category_image != blank %}
                {{ category_image | image_url: width: 560 | image_tag: loading: 'lazy', widths: '180, 280, 420, 560', sizes: '(min-width: 750px) 17vw, 42vw', alt: collection.title }}
              {% else %}
                <span class="category-card__placeholder" aria-hidden="true">{{ collection.title | slice: 0 }}</span>
              {% endif %}
            </span>
            <span class="category-card__title">{{ collection.title | escape }}</span>
          </a>
          {% assign visible_category_count = visible_category_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
      <div class="category-controls" aria-label="Category carousel controls">
        <button class="category-control" type="button" data-category-scroll="previous" aria-label="Scroll to previous categories" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button class="category-control" type="button" data-category-scroll="next" aria-label="Scroll to more categories" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% stylesheet %}
  .category-section {
    width: min(100%, var(--page-width, 100%));
    margin-inline: auto;
  }

  .category-panel {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--freshomill-color-brand-soft);
    padding: var(--freshomill-space-6) var(--freshomill-page-gutter);
  }

  .category-heading-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
  }

  .category-heading-copy {
    min-width: 0;
  }

  .category-view-all {
    display: inline-flex;
    min-height: var(--freshomill-touch-target);
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--freshomill-color-brand-deep);
    font-size: var(--freshomill-font-size-small);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .category-view-all:hover,
  .category-view-all:focus-visible {
    color: var(--freshomill-color-brand-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .category-view-all svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .category-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 4px;
    color: var(--freshomill-color-brand-strong);
    font-size: var(--freshomill-font-size-caption);
    font-weight: 650;
    line-height: 1.2;
  }

  .category-eyebrow span {
    color: var(--freshomill-color-brand);
    font-size: 16px;
  }

  .category-heading-row h2 {
    margin: 0;
    color: var(--freshomill-color-brand-deep);
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 750;
    letter-spacing: -0.045em;
    line-height: 1.12;
  }

  .category-controls {
    display: flex;
    position: absolute;
    inset: 0;
    z-index: 2;
    align-items: center;
    justify-content: space-between;
    padding-inline: 6px;
    pointer-events: none;
  }

  .category-carousel {
    position: relative;
  }

  .category-controls[hidden] {
    display: none;
  }

  .category-control {
    display: grid;
    width: var(--freshomill-touch-target);
    height: var(--freshomill-touch-target);
    place-items: center;
    border: 1px solid var(--freshomill-color-border);
    border-radius: 50%;
    color: var(--freshomill-color-brand-strong);
    background: rgb(255 255 255 / 78%);
    backdrop-filter: blur(8px);
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 2px 10px rgb(17 49 30 / 14%);
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .category-control:hover,
  .category-control:focus-visible {
    border-color: var(--freshomill-color-brand);
    color: var(--freshomill-color-surface);
    background: var(--freshomill-color-brand);
  }

  .category-control:disabled {
    visibility: hidden;
    pointer-events: none;
  }

  .category-control svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .category-track {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 10px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .category-track::-webkit-scrollbar {
    display: none;
  }

  .category-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 7px;
    padding: 5px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 90%);
    border-radius: var(--freshomill-radius-panel);
    color: var(--freshomill-color-ink);
    background: var(--freshomill-color-surface);
    text-align: center;
    text-decoration: none;
    scroll-snap-align: start;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .category-card:hover,
  .category-card:focus-visible {
    color: var(--freshomill-color-ink);
    box-shadow: 0 5px 14px rgb(23 74 42 / 12%);
    transform: translateY(-2px);
  }

  .category-card__image {
    display: block;
    aspect-ratio: 1.08;
    overflow: hidden;
    border-radius: var(--freshomill-radius-card);
    background: var(--freshomill-color-hero);
  }

  .category-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .category-card:hover .category-card__image img {
    transform: scale(1.04);
  }

  .category-card__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: #967944;
    background: radial-gradient(ellipse at 50% 70%, #e9d7af 0 23%, transparent 24%), linear-gradient(145deg, #fbf6e9, #e9eadb);
    font-family: Georgia, serif;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1;
  }


  .category-card__title {
    display: -webkit-box;
    min-height: 2.35em;
    overflow: hidden;
    color: var(--freshomill-color-ink);
    font-size: var(--freshomill-font-size-small);
    font-weight: 650;
    line-height: 1.15;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media screen and (min-width: 750px) {
    .category-track {
      grid-template-columns: repeat(var(--category-count, 5), minmax(0, 1fr));
      grid-auto-columns: auto;
    }

    .category-card {
      width: 100%;
      max-width: 280px;
      justify-self: center;
    }

    .category-card__image {
      aspect-ratio: 1.25;
    }
  }

  @media screen and (max-width: 749px) {
    .category-controls { display: none !important; }

    .category-panel {
      padding: var(--freshomill-space-3) var(--freshomill-page-gutter);
    }

    .category-heading-row {
      align-items: center;
      gap: 8px;
      margin-bottom: 9px;
    }

    .category-eyebrow {
      margin-bottom: 3px;
      font-size: var(--freshomill-font-size-caption);
    }

    .category-eyebrow span {
      font-size: var(--freshomill-font-size-small);
    }

    .category-heading-row h2 {
      max-width: 460px;
      font-size: clamp(16px, 4.8vw, 21px);
      letter-spacing: -0.04em;
    }

    .category-view-all {
      gap: 4px;
      font-size: var(--freshomill-font-size-caption);
    }

    .category-view-all svg {
      width: 14px;
      height: 14px;
    }

    .category-control {
      width: 29px;
      height: 29px;
    }

    .category-control svg {
      width: 15px;
      height: 15px;
    }

    .category-track {
      grid-template-columns: none;
      grid-auto-columns: 40%;
      gap: var(--freshomill-space-2);
      margin-inline: 0;
      padding: var(--freshomill-space-1);
      touch-action: pan-x;
      -webkit-overflow-scrolling: touch;
    }

    .category-card {
      gap: 5px;
      padding: 4px;
      border-radius: var(--freshomill-radius-card);
    }

    .category-card__image {
      aspect-ratio: 1.16;
      border-radius: var(--freshomill-radius-control);
    }

    .category-card__title {
      min-height: 2.3em;
      font-size: var(--freshomill-font-size-caption);
      line-height: 1.12;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const updateCategoryControls = (panel) => {
      const track = panel.querySelector('[data-category-track]');
      const controls = panel.querySelector('.category-controls');
      if (!track || !controls) return;

      const canScroll = track.scrollWidth > track.clientWidth + 1;
      const previous = controls.querySelector('[data-category-scroll="previous"]');
      const next = controls.querySelector('[data-category-scroll="next"]');
      controls.hidden = !canScroll;
      previous.disabled = !canScroll || track.scrollLeft <= 1;
      next.disabled = !canScroll || track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const initializeCategoryControls = (root = document) => {
      root.querySelectorAll('.category-panel').forEach((panel) => {
        const track = panel.querySelector('[data-category-track]');
        if (!track || track.dataset.categoryControlsReady) return;
        track.dataset.categoryControlsReady = 'true';

        const refresh = () => updateCategoryControls(panel);
        track.addEventListener('scroll', refresh, { passive: true });
        window.addEventListener('resize', refresh);
        refresh();
      });
    };

    document.addEventListener('click', (event) => {
      const control = event.target.closest('[data-category-scroll]');
      if (!control || control.disabled) return;

      const track = control.closest('.category-panel')?.querySelector('[data-category-track]');
      const firstCard = track?.querySelector('.category-card');
      if (!track || !firstCard) return;

      const direction = control.dataset.categoryScroll === 'next' ? 1 : -1;
      const cardStep = firstCard.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0);
      track.scrollBy({ left: direction * cardStep, behavior: 'smooth' });
    });

    initializeCategoryControls();
    document.addEventListener('shopify:section:load', (event) => initializeCategoryControls(event.target));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Category carousel",
  "class": "category-list-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything we mill, press and pack"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Categories",
      "limit": 5
    }
  ],
  "presets": [
    {
      "name": "Category carousel",
      "category": "Collections"
    }
  ]
}
{% endschema %}
