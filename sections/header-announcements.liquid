<aside class="announcement-bar section section--full-width" aria-label="Store information">
  <div class="announcement-bar__marquee">
    <div class="announcement-bar__marquee-track">
      {% for copy in (1..8) %}
        <div class="announcement-bar__messages"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {% for index in (1..5) %}
            {% assign message_key = 'message_' | append: index %}
            {% assign link_key = 'link_' | append: index %}
            {% assign message = section.settings[message_key] %}
            {% assign message_link = section.settings[link_key] %}
            {% if message != blank %}
              <span class="announcement-bar__item">
                {% if message_link != blank %}
                  <a class="announcement-bar__message" href="{{ message_link }}">{{ message | escape }}</a>
                {% else %}
                  <span class="announcement-bar__message">{{ message | escape }}</span>
                {% endif %}
              </span>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar.section {
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 28px;
    margin-block: 0;
    min-height: 28px;
    padding: 0;
    color: #fff;
    background: #075f3b;
  }

  .announcement-bar > * {
    grid-column: 1 / -1;
    flex: 1 1 auto;
    min-width: 0;
  }

  .shopify-section:has(> .announcement-bar) {
    position: relative;
    flex: 0 0 28px;
    height: 28px;
    min-height: 28px;
    margin-block: 0;
    padding-block: 0;
    overflow: hidden;
    background: #075f3b;
  }

  .announcement-bar__marquee {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: #fff;
    background: transparent;
  }

  .announcement-bar__marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    align-items: center;
    white-space: nowrap;
    animation: announcement-bar-motion 34s linear infinite;
  }

  .announcement-bar__messages {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    width: max-content;
    padding-inline: clamp(16px, 2vw, 32px);
  }

  .announcement-bar__messages > * {
    flex: 0 0 auto;
  }

  .announcement-bar__item,
  .announcement-bar__message {
    display: inline-flex;
    align-items: center;
    color: #fff !important;
    font-family: var(--font-body--family, Arial, sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.25;
    text-transform: none;
    text-decoration: none;
    visibility: visible;
    opacity: 1;
  }

  .announcement-bar__item {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .announcement-bar__item::after {
    content: '.';
    display: inline-block;
    color: #fff;
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    margin-inline: clamp(24px, 3.5vw, 52px);
  }

  .announcement-bar__message {
    position: relative;
    min-height: 28px;
    text-decoration: none;
  }

  @keyframes announcement-bar-motion {
    to {
      transform: translate3d(-12.5%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "text", "id": "message_1", "label": "Message 1", "default": "Washed & Cleaned" },
    { "type": "url", "id": "link_1", "label": "Message 1 link" },
    { "type": "text", "id": "message_2", "label": "Message 2", "default": "No Preservatives Or Adulterants" },
    { "type": "url", "id": "link_2", "label": "Message 2 link" },
    { "type": "text", "id": "message_3", "label": "Message 3", "default": "Freshly Packed On Order" },
    { "type": "url", "id": "link_3", "label": "Message 3 link" },
    { "type": "text", "id": "message_4", "label": "Message 4", "default": "Premium Quality Ingredients" },
    { "type": "url", "id": "link_4", "label": "Message 4 link" },
    { "type": "text", "id": "message_5", "label": "Message 5", "default": "Sourced From Local Farms" },
    { "type": "url", "id": "link_5", "label": "Message 5 link" }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "category": "t:categories.header"
    }
  ]
}
{% endschema %}
