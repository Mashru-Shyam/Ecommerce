<aside
  class="announcement-bar section section--full-width"
  aria-label="Store information"
>
  <div class="announcement-bar__marquee">
    <div class="announcement-bar__marquee-track">
      {% for copy in (1..8) %}
        <div class="announcement-bar__messages"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {% for block in section.blocks %}
            {% assign block_settings = block.settings %}
            {% assign plain_text = block_settings.text | strip_newlines | strip_html | strip %}
            {% unless plain_text == blank %}
              <div class="announcement-bar__item"{% if forloop.parentloop.first %} {{ block.shopify_attributes }}{% endif %}>
                {% if block_settings.link != blank %}
                  <a
                    class="announcement-bar__message"
                    href="{{ block_settings.link }}"
                    style="{% render 'typography-style', settings: block_settings, preset: 'custom' %}--line-height: 1.25;{% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }};{% endif %}"
                  >
                    {{ block_settings.text }}
                  </a>
                {% else %}
                  <span
                    class="announcement-bar__message"
                    style="{% render 'typography-style', settings: block_settings, preset: 'custom' %}--line-height: 1.25;{% if block_settings.text_color != blank %}--color: {{ block_settings.text_color }};{% endif %}"
                  >
                    {{ block_settings.text }}
                  </span>
                {% endif %}
              </div>
            {% endunless %}
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar.section {
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 28px;
    margin-block: 0;
    min-height: 28px;
    padding: 0;
    color: #fff;
    background: #075f3b;
  }

  .announcement-bar > * {
    grid-column: 1 / -1;
    flex: 1 1 auto;
    min-width: 0;
  }

  .shopify-section:has(> .announcement-bar) {
    position: relative;
    flex: 0 0 28px;
    height: 28px;
    min-height: 28px;
    margin-block: 0;
    padding-block: 0;
    overflow: hidden;
    background: #075f3b;
  }

  .announcement-bar__marquee {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: #fff;
    background: transparent;
  }

  .announcement-bar__marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    align-items: center;
    white-space: nowrap;
    animation: announcement-bar-motion 34s linear infinite;
  }

  .announcement-bar__messages {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    width: max-content;
  }

  .announcement-bar__messages {
    gap: clamp(28px, 4vw, 64px);
    padding-inline: clamp(16px, 2vw, 32px);
  }

  .announcement-bar__messages > * {
    flex: 0 0 auto;
  }

  .announcement-bar__item,
  .announcement-bar__message {
    display: inline-flex;
    align-items: center;
    color: var(--color, #fff);
    font-family: var(--font-family, var(--font-body--family));
    font-size: var(--font-size, 0.875rem);
    font-weight: var(--font-weight, 600);
    letter-spacing: var(--letter-spacing, normal);
    line-height: var(--line-height, 1.25);
    text-transform: var(--text-transform, none);
    text-decoration: none;
  }

  .announcement-bar__item {
    flex: 0 0 auto;
  }

  .announcement-bar__message {
    position: relative;
    min-height: 28px;
    text-decoration: none;
  }

  @keyframes announcement-bar-motion {
    to {
      transform: translate3d(-12.5%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track {
      animation: none;
    }
  }
{% endstylesheet %}

