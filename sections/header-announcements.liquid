<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<aside
  class="announcement-bar section section--full-width"
  aria-label="Store information"
  style="background-color: #075f3b; color: #fff;"
>
  <marquee-component
    class="announcement-bar__marquee"
    data-speed-factor="25"
    data-movement-direction="normal"
  >
    <div class="announcement-bar__marquee-track" ref="wrapper">
      <div class="announcement-bar__marquee-content" ref="content">
        <div class="announcement-bar__messages" ref="marqueeItems[]">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </marquee-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 28px;
    padding: 4px 0;
    color: #fff;
    background: #075f3b;
  }

  .announcement-bar__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .announcement-bar__marquee-track {
    display: flex;
    width: fit-content;
    white-space: nowrap;
    animation: announcement-bar-motion 34s linear infinite;
  }

  .announcement-bar__marquee-content,
  .announcement-bar__messages {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .announcement-bar__messages {
    gap: clamp(36px, 5vw, 88px);
    padding-inline: clamp(18px, 2.5vw, 44px);
  }

  .announcement-bar__messages > * {
    flex: 0 0 auto;
  }

  .announcement-bar__message {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: clamp(36px, 5vw, 88px);
    color: var(--color, #fff);
    font-family: var(--font-family, var(--font-body--family));
    font-size: var(--font-size, 1rem);
    font-weight: var(--font-weight, 600);
    letter-spacing: var(--letter-spacing, normal);
    line-height: var(--line-height, 1.25);
    text-transform: var(--text-transform, none);
    text-decoration: none;
  }

  .announcement-bar__message::after {
    content: '.';
    position: absolute;
    inset-inline-end: calc(clamp(36px, 5vw, 88px) / -2 - 0.15em);
    color: #fff;
    font-size: 1.25em;
    font-weight: 700;
    line-height: 1;
  }

  @keyframes announcement-bar-motion {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__marquee-track {
      animation: none;
    }
  }
{% endstylesheet %}

