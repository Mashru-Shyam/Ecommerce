<main class="customer-order-page">
  <a class="customer-order-page__back" href="{{ routes.account_url }}#my-orders"> My Orders</a>
  <header class="customer-order-page__heading"><div class="customer-order-page__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7l9-5Z"/><path d="m3.5 7.3 8.5 4.8 8.5-4.8M12 12v10"/></svg></div><div><h1>Order {{ order.name | escape }}</h1><p>Placed {{ order.created_at | date: '%d %b %Y, %I:%M %p' }}{% if order.cancelled %} - Cancelled{% elsif order.fulfillment_status_label != blank %} - {{ order.fulfillment_status_label }}{% endif %}</p></div><strong>{{ order.total_price | money }}</strong></header>
  <section class="customer-order-page__card">
    <h2>Items in this order</h2>
    {% for line_item in order.line_items %}
      <article class="customer-order-page__item">
        <a class="customer-order-page__image" href="{{ line_item.product.url | default: routes.all_products_collection_url }}">{% if line_item.image %}{{ line_item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: line_item.title }}{% endif %}</a>
        <div class="customer-order-page__details"><h3>{{ line_item.title | escape }}</h3><p>{{ line_item.variant.title | escape }}{% if line_item.quantity > 1 %}  Qty {{ line_item.quantity }}{% endif %}</p></div>
        <strong>{{ line_item.final_line_price | money }}</strong>
      </article>
    {% endfor %}
    <dl class="customer-order-page__totals"><div><dt>Subtotal</dt><dd>{{ order.subtotal_price | money }}</dd></div>{% for discount in order.cart_level_discount_applications %}<div><dt>{{ discount.title | escape }}</dt><dd>-{{ discount.total_allocated_amount | money }}</dd></div>{% endfor %}<div><dt>Shipping</dt><dd>{{ order.shipping_price | money }}</dd></div><div><dt>Taxes</dt><dd>{{ order.tax_price | money }}</dd></div><div class="is-total"><dt>Total</dt><dd>{{ order.total_price | money }}</dd></div></dl>
  </section>
  <div class="customer-order-page__columns">
    <section class="customer-order-page__card"><h2>Delivery address</h2><address>{{ order.shipping_address | format_address }}</address>{% if order.fulfillment_status == 'fulfilled' %}<p class="customer-order-page__tracking">Your order has been fulfilled.{% for fulfillment in order.fulfillments %}{% if fulfillment.tracking_number != blank %}<br>Tracking: <a href="{{ fulfillment.tracking_url }}">{{ fulfillment.tracking_number | escape }}</a>{% endif %}{% endfor %}</p>{% else %}<p class="customer-order-page__tracking">We will show tracking details here when your order ships.</p>{% endif %}</section>
    <section class="customer-order-page__card"><h2>Payment</h2><p>{{ order.financial_status_label | escape }}</p><p>{{ order.email | escape }}</p></section>
  </div>
</main>
{% stylesheet %}
  .customer-order-page__icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .customer-order-page { width: min(1040px,calc(100% - 40px)); margin: 24px auto 56px; color: #213329; }.customer-order-page__back { color: #176b1c; font-size: 12px; }.customer-order-page__heading { display: flex; align-items: center; gap: 12px; margin: 18px 0; padding: 16px; border: 1px solid #e8eee5; border-radius: 10px; background: #f5f8f1; }.customer-order-page__heading h1 { margin: 0; font-size: 23px; }.customer-order-page__heading p { margin: 4px 0 0; color: #707a70; font-size: 11px; }.customer-order-page__heading > strong { margin-inline-start: auto; font-size: 20px; }.customer-order-page__icon { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 50%; background: #e8f4df; color: #176b1c; font-size: 23px; }.customer-order-page__card { padding: 18px; border: 1px solid #edf0e9; border-radius: 10px; background: #fff; box-shadow: 0 4px 20px rgb(34 53 35 / .04); }.customer-order-page__card h2 { margin: 0 0 12px; font-size: 16px; }.customer-order-page__item { display: grid; grid-template-columns: 62px 1fr auto; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid #edf0eb; }.customer-order-page__image { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 7px; background: #f6f5ee; }.customer-order-page__image img { width: 100%; height: 100%; object-fit: contain; }.customer-order-page__details h3 { margin: 0; font-size: 13px; }.customer-order-page__details p { margin: 4px 0 0; color: #6c756d; font-size: 11px; }.customer-order-page__totals { display: grid; gap: 8px; margin: 12px 0 0 auto; max-width: 300px; font-size: 12px; }.customer-order-page__totals div { display: flex; justify-content: space-between; gap: 20px; }.customer-order-page__totals dd { margin: 0; }.customer-order-page__totals .is-total { padding-top: 10px; border-top: 1px solid #e9eee7; font-size: 17px; font-weight: 700; }.customer-order-page__columns { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }.customer-order-page__card address { font-size: 12px; font-style: normal; line-height: 1.6; }.customer-order-page__card > p,.customer-order-page__tracking { color: #677168; font-size: 12px; }.customer-order-page__card a { color: #176b1c; }
  @media(max-width:749px) { .customer-order-page { width: auto; margin: 16px 12px 36px; }.customer-order-page__heading { padding: 12px; }.customer-order-page__heading h1 { font-size: 17px; }.customer-order-page__heading > strong { font-size: 16px; }.customer-order-page__card { padding: 13px; }.customer-order-page__columns { grid-template-columns: 1fr; } }
{% endstylesheet %}
