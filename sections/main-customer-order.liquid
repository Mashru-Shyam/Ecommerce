<section class="customer-order-page" aria-label="Order details">
  <a class="customer-order-page__back" href="{{ routes.account_url }}#my-orders"> My Orders</a>
  <header class="customer-order-page__heading"><div class="customer-order-page__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7l9-5Z"/><path d="m3.5 7.3 8.5 4.8 8.5-4.8M12 12v10"/></svg></div><div class="customer-order-page__heading-copy"><h1>Order {{ order.name | escape }}</h1><p>Placed {{ order.created_at | date: '%d %b %Y, %I:%M %p' }}</p></div><div class="customer-order-page__heading-meta"><span class="customer-order-page__status{% if order.cancelled %} is-cancelled{% elsif order.fulfillment_status == 'fulfilled' %} is-complete{% endif %}">{% if order.cancelled %}Cancelled{% elsif order.fulfillment_status_label != blank %}{{ order.fulfillment_status_label | escape }}{% else %}Processing{% endif %}</span><strong>{{ order.total_price | money }}</strong></div></header>
  <section class="customer-order-page__card">
    <h2>Items in this order</h2>
    {% for line_item in order.line_items %}
      <article class="customer-order-page__item">
        <a class="customer-order-page__image" href="{{ line_item.product.url | default: routes.all_products_collection_url }}">{% if line_item.image %}{{ line_item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: line_item.title }}{% endif %}</a>
        <div class="customer-order-page__details"><h3>{{ line_item.title | escape }}</h3><p>{{ line_item.variant.title | escape }}{% if line_item.quantity > 1 %}  Qty {{ line_item.quantity }}{% endif %}</p></div>
        <strong>{{ line_item.final_line_price | money }}</strong>
      </article>
    {% endfor %}
    <dl class="customer-order-page__totals"><div><dt>Subtotal</dt><dd>{{ order.subtotal_price | money }}</dd></div>{% for discount in order.cart_level_discount_applications %}<div><dt>{{ discount.title | escape }}</dt><dd>-{{ discount.total_allocated_amount | money }}</dd></div>{% endfor %}<div><dt>Shipping</dt><dd>{{ order.shipping_price | money }}</dd></div><div><dt>Taxes</dt><dd>{{ order.tax_price | money }}</dd></div><div class="is-total"><dt>Total</dt><dd>{{ order.total_price | money }}</dd></div></dl>
  </section>
  <div class="customer-order-page__columns">
    <section class="customer-order-page__card"><h2>Delivery address</h2><address>{{ order.shipping_address | format_address }}</address>{% if order.fulfillment_status == 'fulfilled' %}<p class="customer-order-page__tracking">Your order has been fulfilled.{% for fulfillment in order.fulfillments %}{% if fulfillment.tracking_number != blank %}<br>Tracking: <a href="{{ fulfillment.tracking_url }}">{{ fulfillment.tracking_number | escape }}</a>{% endif %}{% endfor %}</p>{% else %}<p class="customer-order-page__tracking">We will show tracking details here when your order ships.</p>{% endif %}</section>
    <section class="customer-order-page__card"><h2>Payment</h2><p>{{ order.financial_status_label | escape }}</p><p>{{ order.email | escape }}</p></section>
  </div>
</section>
{% stylesheet %}
  .customer-order-page__icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .customer-order-page { width: min(1040px,calc(100% - var(--freshomill-page-gutter) - var(--freshomill-page-gutter))); margin: var(--freshomill-space-5) auto var(--freshomill-space-7); color: var(--freshomill-color-ink); }.customer-order-page__back { color: var(--freshomill-color-brand); font-size: var(--freshomill-font-size-caption); text-decoration-thickness: 1px; text-underline-offset: 3px; }.customer-order-page__heading { display: flex; align-items: center; gap: var(--freshomill-space-3); margin: var(--freshomill-space-4) 0; padding: var(--freshomill-space-4); border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-panel); background: linear-gradient(110deg,var(--freshomill-color-brand-soft),var(--freshomill-color-surface)); box-shadow: 0 5px 20px rgb(34 53 35 / .04); }.customer-order-page__heading-copy { flex: 1; min-width: 0; }.customer-order-page__heading h1 { margin: 0; font-size: clamp(19px,2vw,24px); letter-spacing: -.025em; }.customer-order-page__heading p { margin: 4px 0 0; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); }.customer-order-page__heading-meta { display: flex; align-items: center; gap: var(--freshomill-space-3); }.customer-order-page__heading-meta > strong { font-size: 20px; white-space: nowrap; }.customer-order-page__status { padding: 7px 10px; border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-warning-soft); color: var(--freshomill-color-warning); font-size: var(--freshomill-font-size-caption); font-weight: 650; white-space: nowrap; }.customer-order-page__status.is-complete { background: var(--freshomill-color-success-soft); color: var(--freshomill-color-success); }.customer-order-page__status.is-cancelled { background: var(--freshomill-color-danger-soft); color: var(--freshomill-color-danger); }.customer-order-page__icon { display: grid; width: 40px; height: 40px; flex: 0 0 40px; place-items: center; border-radius: 50%; background: var(--freshomill-color-brand-soft); color: var(--freshomill-color-brand); }.customer-order-page__card { padding: var(--freshomill-space-5); border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-panel); background: var(--freshomill-color-surface); box-shadow: 0 4px 20px rgb(34 53 35 / .04); }.customer-order-page__card h2 { margin: 0 0 var(--freshomill-space-3); font-size: 16px; }.customer-order-page__item { display: grid; grid-template-columns: 62px minmax(0,1fr) auto; gap: var(--freshomill-space-3); align-items: center; padding: 10px 0; border-top: 1px solid var(--freshomill-color-border); }.customer-order-page__image { display: block; aspect-ratio: 1; overflow: hidden; border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-surface-warm); }.customer-order-page__image img { width: 100%; height: 100%; object-fit: contain; }.customer-order-page__details h3 { margin: 0; font-size: var(--freshomill-font-size-small); }.customer-order-page__details p { margin: 4px 0 0; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); }.customer-order-page__totals { display: grid; gap: var(--freshomill-space-2); margin: var(--freshomill-space-3) 0 0 auto; max-width: 340px; font-size: var(--freshomill-font-size-caption); }.customer-order-page__totals div { display: flex; justify-content: space-between; gap: var(--freshomill-space-5); }.customer-order-page__totals dd { margin: 0; }.customer-order-page__totals .is-total { margin-top: 4px; padding: 12px; border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-brand-soft); font-size: 17px; font-weight: 700; }.customer-order-page__columns { display: grid; grid-template-columns: 1fr 1fr; gap: var(--freshomill-space-3); margin-top: var(--freshomill-space-3); }.customer-order-page__card address { font-size: var(--freshomill-font-size-caption); font-style: normal; line-height: 1.6; }.customer-order-page__card > p,.customer-order-page__tracking { color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); }.customer-order-page__card a { color: var(--freshomill-color-brand); }
  @media(max-width:989px) and (min-width:750px) { .customer-order-page__columns { grid-template-columns: 1fr; } }
  @media(max-width:749px) { .customer-order-page { width: auto; margin: var(--freshomill-space-4) var(--freshomill-page-gutter) var(--freshomill-space-6); }.customer-order-page__heading { flex-wrap: wrap; gap: var(--freshomill-space-2); padding: var(--freshomill-space-3); }.customer-order-page__heading h1 { font-size: 17px; }.customer-order-page__heading-meta { width: 100%; justify-content: space-between; padding-inline-start: 52px; }.customer-order-page__heading-meta > strong { font-size: 16px; }.customer-order-page__card { padding: var(--freshomill-space-4); }.customer-order-page__item { grid-template-columns: 52px minmax(0,1fr) auto; gap: var(--freshomill-space-2); }.customer-order-page__columns { grid-template-columns: 1fr; } }
{% endstylesheet %}
