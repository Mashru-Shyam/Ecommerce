

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'collection-wrapper-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<results-list
  class="section product-grid-container spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div class="collection-wrapper collection-wrapper--catalog collection-wrapper--search-catalog grid gap-style">
    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate search.results by products_per_page %}
      {% content_for 'block', type: 'filters', id: 'filters', results: search, results_size: search.results_count %}
      {% assign products = search.results | where: 'object_type', 'product' %}

      {% capture children %}
        {% for product in products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% content_for 'block',
              type: '_product-card',
              id: 'product-card',
              closest.product: product,
              product_view_context: 'search'
            %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll,
        title: title
      %}
    {% endpaginate %}
  </div>
</results-list>

{% style %}
  .collection-wrapper--search-catalog {
    column-gap: 16px;
    row-gap: 8px;
    padding-inline: clamp(12px, 2vw, 28px);
    margin-block-start: 8px;
  }

  .collection-wrapper--search-catalog > .facets--horizontal.facets-controls-wrapper { display: none; }
  .collection-wrapper--search-catalog > .facets-block-wrapper--vertical { grid-column: 1; grid-row: 1 / span 2; margin: 0; }
  .collection-wrapper--search-catalog > .facets-toggle { display: none; }
  .collection-wrapper--search-catalog > #ResultsList { grid-column: 2; grid-row: 1 / span 2; min-width: 0; width: 100%; max-width: none; }
  .collection-wrapper--search-catalog > #ResultsList > div { width: 100%; max-width: none; }
  .collection-wrapper--search-catalog > #ResultsList .product-grid { width: 100%; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 16px; }

  @media screen and (min-width: 750px) {
    .collection-wrapper--search-catalog.grid { grid-template-columns: minmax(220px, min(24vw, 320px)) minmax(0, 1fr); grid-template-rows: var(--freshomill-touch-target) auto; align-items: start; }
    .collection-wrapper--search-catalog > .facets--horizontal.facets-controls-wrapper { display: grid; grid-template-columns: minmax(220px, min(24vw, 320px)) minmax(0, 1fr); column-gap: 16px; grid-column: 1 / -1; grid-row: 1; min-height: var(--freshomill-touch-target); margin: 0; padding: 0; }
    .collection-wrapper--search-catalog .catalog-desktop-results-controls { grid-column: 2; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-width: 0; }
    .collection-wrapper--search-catalog .catalog-desktop-results-controls .products-count-wrapper { margin: 0; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-small); white-space: nowrap; }
    .collection-wrapper--search-catalog .catalog-desktop-results-controls sorting-filter-component { margin-inline-start: auto; }
    .collection-wrapper--search-catalog > .facets-block-wrapper--vertical { display: grid; grid-template-rows: var(--freshomill-touch-target) auto; align-content: start; row-gap: 8px; grid-column: 1; grid-row: 1 / span 2; margin: 0; padding-block-start: 0; --facets-margin: 0; }
    .collection-wrapper--search-catalog > .facets-block-wrapper--vertical > .catalog-filter-links { display: contents; }
    .collection-wrapper--search-catalog > .facets-block-wrapper--vertical .catalog-filter-links__title { grid-row: 1; align-self: center; margin: 0; line-height: 1.25; }
    .collection-wrapper--search-catalog > .facets-block-wrapper--vertical .catalog-filter-links__list { grid-row: 2; }
    .collection-wrapper--search-catalog > #ResultsList { grid-column: 2; grid-row: 2; }
  }

  @media screen and (max-width: 749px) {
    .collection-wrapper--search-catalog { display: block; padding-inline: var(--freshomill-page-gutter); }
    .collection-wrapper--search-catalog > .facets--horizontal.facets-controls-wrapper { display: none; }
    .collection-wrapper--search-catalog > .facets-block-wrapper--vertical:not(#filters-drawer) { display: none; }
    .collection-wrapper--search-catalog > .facets-toggle { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: var(--freshomill-touch-target); margin: 0 0 12px; padding: 0; }
    .collection-wrapper--search-catalog .facets-toggle__button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: var(--freshomill-touch-target); padding: 6px 12px; border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-card); background: var(--freshomill-color-surface); color: var(--freshomill-color-brand-strong); font-size: var(--freshomill-font-size-small); font-weight: 650; }
    .collection-wrapper--search-catalog .catalog-mobile-products-count { display: block; flex: 1 1 auto; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-small); }
    .collection-wrapper--search-catalog .facets-mobile-wrapper { display: flex; flex: 0 0 auto; }
    .collection-wrapper--search-catalog .sorting-filter__container { display: none !important; }
    .collection-wrapper--search-catalog .sorting-filter .facets__panel { border: 0; background: transparent; }
    .collection-wrapper--search-catalog .sorting-filter .facets__summary { display: flex; min-height: var(--freshomill-touch-target); padding: 6px 2px; border: 0; background: transparent; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-small); }
    .collection-wrapper--search-catalog > #ResultsList { width: 100%; }
    .collection-wrapper--search-catalog > #ResultsList .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 8px; }
    #filters-drawer .theme-drawer__dialog { position: fixed; inset: auto 0 -100% !important; width: 100%; max-width: none; max-height: min(88dvh, 760px); height: auto; margin: 0; padding: 0; border: 0; border-radius: var(--freshomill-radius-panel) var(--freshomill-radius-panel) 0 0; overflow: hidden; box-shadow: 0 -12px 40px rgb(0 0 0 / .16); }
    #filters-drawer .theme-drawer__dialog[open] { inset: auto 0 0 !important; }
    #filters-drawer .theme-drawer__header { position: relative; padding: 20px var(--freshomill-page-gutter) 12px; border: 0; touch-action: pan-x; }
    #filters-drawer .theme-drawer__header::before { position: absolute; top: 7px; left: 50%; width: 36px; height: 4px; border-radius: 999px; background: var(--freshomill-color-border); content: ''; transform: translateX(-50%); }
    #filters-drawer .facets-drawer__filters { max-height: calc(88dvh - 150px); overflow: auto; padding: var(--freshomill-space-3) var(--freshomill-page-gutter) var(--freshomill-space-4); }
    #filters-drawer .catalog-filter-links { margin: 0 0 var(--freshomill-space-4); padding: 0; border: 0; }
    #filters-drawer .catalog-category { min-height: 72px; padding: 7px; }
    #filters-drawer .facets__drawer-actions { display: flex; padding: var(--freshomill-space-3) var(--freshomill-page-gutter) max(var(--freshomill-space-4), env(safe-area-inset-bottom)); }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:names.search_results",
  "settings": [
    {
      "type": "collection_list",
      "id": "catalog_categories",
      "label": "Catalog categories",
      "limit": 12
    },
    {
      "type": "paragraph",
      "content": "t:content.edit_empty_state_collection_in_theme_settings"
    },
    {
      "type": "select",
      "id": "quick_add_position",
      "label": "Quick add position",
      "options": [
        { "value": "overlay", "label": "On product image" },
        { "value": "below", "label": "Below product details" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
