{% liquid
  assign contact_address = section.settings.contact_address | newline_to_br
  assign map_query = section.settings.contact_address | url_encode
  assign contact_form_id = 'ContactForm-' | append: section.id
  assign has_contact_details = false
  if section.settings.contact_address != blank or section.settings.phone != blank or section.settings.email != blank or section.settings.hours != blank
    assign has_contact_details = true
  endif
  assign has_contact_socials = false
  if section.settings.instagram_url != blank or section.settings.youtube_url != blank or section.settings.linkedin_url != blank
    assign has_contact_socials = true
  endif
%}

<section class="contact-page" aria-labelledby="ContactHeading-{{ section.id }}">
  <div class="contact-page__hero">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'contact-page__hero-image', widths: '750, 1100, 1500, 1900, 2200', sizes: '100vw', loading: 'eager', alt: '' }}
    {% endif %}
    <div class="contact-page__hero-inner">
      <p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="ContactHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      <p class="contact-page__intro">{{ section.settings.intro | escape | newline_to_br }}</p>
    </div>
  </div>

  <div class="contact-page__content{% unless has_contact_details or has_contact_socials %} contact-page__content--form-only{% endunless %}">
    <div class="contact-page__form-card">
      <header class="contact-page__form-heading">
        <span class="contact-page__icon contact-page__icon--large" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v12h-17zM4 7l8 6 8-6"/></svg>
        </span>
        <div>
          <h2>{{ section.settings.form_title | escape }}</h2>
          <p>{{ section.settings.form_description | escape }}</p>
        </div>
      </header>

      {% form 'contact', id: contact_form_id, class: 'contact-page__form' %}
        {% if form.posted_successfully? %}
          <div class="contact-page__notice contact-page__notice--success" role="status">
            <span class="contact-page__notice-icon" aria-hidden="true">✓</span>
            <div><strong>{{ section.settings.success_title | escape }}</strong><p>{{ section.settings.success_message | escape }}</p></div>
            <button type="button" class="contact-page__notice-close" aria-label="{{ 'accessibility.close' | t }}" data-contact-notice-close>×</button>
          </div>
        {% endif %}
        {% if form.errors %}
          <div class="contact-page__notice contact-page__notice--error" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <label for="ContactName-{{ section.id }}">{{ 'blocks.contact_form.name' | t }} <span>*</span></label>
        <div class="contact-page__field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20v-1.4a6.5 6.5 0 0 1 13 0V20z"/></svg>
          <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" placeholder="{{ section.settings.name_placeholder | escape }}" required>
        </div>

        <label for="ContactEmail-{{ section.id }}">{{ 'blocks.contact_form.email' | t }} <span>*</span></label>
        <div class="contact-page__field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4.5 7 7.5 5.5L19.5 7"/></svg>
          <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" placeholder="{{ section.settings.email_placeholder | escape }}" required>
        </div>

        <label for="ContactPhone-{{ section.id }}">{{ section.settings.phone_label | escape }} <span class="contact-page__optional">({{ section.settings.optional_label | escape }})</span></label>
        <div class="contact-page__field">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h3l1.4 4-2 1.6a14 14 0 0 0 5.5 5.5l1.6-2 4 1.4v3c0 1.1-.9 2-2 2C10.7 19 5 13.3 5 5.5c0-1.1.9-2 2-2Z"/></svg>
          <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}" placeholder="{{ section.settings.phone_placeholder | escape }}">
        </div>

        <label for="ContactMessage-{{ section.id }}">{{ 'blocks.contact_form.comment' | t }} <span>*</span></label>
        <div class="contact-page__field contact-page__field--textarea">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v12H9l-5 3zM7.5 9h9M7.5 13h6"/></svg>
          <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="3" placeholder="{{ section.settings.message_placeholder | escape }}" required>{{ form.body | escape }}</textarea>
        </div>

        <button class="contact-page__submit" type="submit">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-7.4 18-3.4-7.2L3 10.4 21 3Zm-10.8 10.8L21 3"/></svg>
          {{ section.settings.submit_label | escape }}
        </button>
      {% endform %}
    </div>

    {% if has_contact_details or has_contact_socials %}<div class="contact-page__details">
      {% if has_contact_details %}
      <div class="contact-page__info-grid">
        {% if section.settings.contact_address != blank %}
        <article class="contact-page__info-card">
          <span class="contact-page__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
          <div><h2>{{ section.settings.address_title | escape }}</h2><p>{{ contact_address }}</p></div>
        </article>
        {% endif %}
        {% if section.settings.phone != blank %}
        <article class="contact-page__info-card">
          <span class="contact-page__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3.5h3l1.4 4-2 1.6a14 14 0 0 0 5.5 5.5l1.6-2 4 1.4v3c0 1.1-.9 2-2 2C10.7 19 5 13.3 5 5.5c0-1.1.9-2 2-2Z"/></svg></span>
          <div><h2>{{ section.settings.phone_title | escape }}</h2><a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">{{ section.settings.phone | escape }}</a><p class="contact-page__muted">{{ section.settings.phone_note | escape }}</p></div>
        </article>
        {% endif %}
        {% if section.settings.email != blank %}
        <article class="contact-page__info-card">
          <span class="contact-page__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v12h-17zM4 7l8 6 8-6"/></svg></span>
          <div><h2>{{ section.settings.email_title | escape }}</h2><a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a><p class="contact-page__muted">{{ section.settings.email_note | escape }}</p></div>
        </article>
        {% endif %}
        {% if section.settings.hours != blank %}
        <article class="contact-page__info-card">
          <span class="contact-page__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/></svg></span>
          <div><h2>{{ section.settings.hours_title | escape }}</h2><p>{{ section.settings.hours | escape }}</p><p class="contact-page__muted">{{ section.settings.hours_note | escape }}</p></div>
        </article>
        {% endif %}
      </div>
      {% endif %}

      {% if section.settings.contact_address != blank or has_contact_socials %}
      <div class="contact-page__bottom-grid">
        {% if section.settings.contact_address != blank %}
        <article class="contact-page__location-card">
          <h2><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>{{ section.settings.location_title | escape }}</h2>
          <iframe title="{{ section.settings.location_title | escape }}" src="https://maps.google.com/maps?q={{ map_query }}&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </article>
        {% endif %}
        {% if has_contact_socials %}
        <article class="contact-page__social-card">
          <h2><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.8 7.5-4.4M8.2 13.2l7.5 4.4"/></svg>{{ section.settings.social_title | escape }}</h2>
          <p>{{ section.settings.social_description | escape }}</p>
          <div class="contact-page__social-links">
            {% if section.settings.instagram_url != blank %}<a class="contact-page__social-item" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener"><span class="contact-page__social-mark contact-page__social-mark--instagram">◎</span>{{ section.settings.instagram_label | escape }}<span aria-hidden="true">›</span></a>{% endif %}
            {% if section.settings.youtube_url != blank %}<a class="contact-page__social-item" href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener"><span class="contact-page__social-mark contact-page__social-mark--youtube">▶</span>{{ section.settings.youtube_label | escape }}<span aria-hidden="true">›</span></a>{% endif %}
            {% if section.settings.linkedin_url != blank %}<a class="contact-page__social-item" href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener"><span class="contact-page__social-mark contact-page__social-mark--linkedin">in</span>{{ section.settings.linkedin_label | escape }}<span aria-hidden="true">›</span></a>{% endif %}
          </div>
        </article>
        {% endif %}
      </div>
      {% endif %}
    </div>
    {% endif %}
  </div>
  {% render 'freshomill-benefit-strip', context: 'contact' %}
</section>

<script>
  document.querySelectorAll('[data-contact-notice-close]').forEach((button) => {
    button.addEventListener('click', () => button.closest('.contact-page__notice')?.remove());
  });
</script>

{% stylesheet %}
  .contact-page { width: 100vw; max-width: 100vw; margin-inline: calc(50% - 50vw); color: var(--freshomill-color-ink); background: var(--freshomill-color-brand-soft); }
  .contact-page__hero { position: relative; display: flex; width: 100%; aspect-ratio: 3.5 / 1; max-height: 360px; min-height: clamp(220px, 24vw, 300px); margin-block-start: 6px; align-items: center; overflow: hidden; background: var(--freshomill-color-brand-soft); }
  .contact-page__hero::after { position: absolute; inset: 0; content: ''; background: linear-gradient(90deg, var(--freshomill-color-brand-soft) 0%, rgb(243 247 233 / .97) 42%, rgb(243 247 233 / .12) 78%, rgb(243 247 233 / .05) 100%); }
  .contact-page__hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 52%; }
  .contact-page__hero-inner { position: relative; z-index: 1; width: 100%; margin: 0; padding: clamp(18px, 3.5vw, 48px) 0 clamp(16px, 2.6vw, 34px) var(--freshomill-page-gutter); }
  .contact-page__eyebrow { margin: 0 0 5px; color: var(--freshomill-color-brand-strong); font-size: var(--freshomill-font-size-caption); font-weight: 800; letter-spacing: .035em; text-transform: uppercase; }
  .contact-page__hero h1 { margin: 0; font-size: clamp(34px, 4.25vw, 62px); font-weight: 750; letter-spacing: -.055em; line-height: .98; }
  .contact-page__intro { max-width: 460px; margin: 14px 0 0; font-size: clamp(14px, 1.55vw, 20px); line-height: 1.35; }
  .contact-page__content { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr); gap: var(--freshomill-space-4); width: calc(100% - var(--freshomill-page-gutter) - var(--freshomill-page-gutter)); max-width: 1600px; margin: var(--freshomill-space-4) auto var(--freshomill-space-6); position: relative; z-index: 1; }
  .contact-page__content--form-only { grid-template-columns: minmax(0, 880px); justify-content: center; }
  .contact-page__form-card,.contact-page__info-card,.contact-page__location-card,.contact-page__social-card { border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-card); background: rgb(255 255 255 / .96); box-shadow: var(--freshomill-shadow-card); }
  .contact-page__form-card { padding: var(--freshomill-space-5); }
  .contact-page__form-heading { display: flex; align-items: center; gap: var(--freshomill-space-3); margin-bottom: var(--freshomill-space-3); }
  .contact-page__icon { display: grid; width: 38px; height: 38px; flex: 0 0 38px; place-items: center; border-radius: 50%; background: var(--freshomill-color-brand-soft); color: var(--freshomill-color-brand-strong); }
  .contact-page__icon svg,.contact-page__form-heading svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .contact-page__icon--large { width: 46px; height: 46px; flex-basis: 46px; }
  .contact-page__form-heading h2,.contact-page__info-card h2,.contact-page__location-card h2,.contact-page__social-card h2 { margin: 0; font-size: var(--freshomill-font-size-body); font-weight: 750; line-height: 1.25; }
  .contact-page__form-heading p { margin: 3px 0 0; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); line-height: 1.35; }
  .contact-page__form { display: grid; gap: var(--freshomill-space-2); }
  .contact-page__form label { margin-top: var(--freshomill-space-1); font-size: var(--freshomill-font-size-caption); font-weight: 700; line-height: 1.3; }
  .contact-page__form label > span:first-child { color: #a12c2c; }
  .contact-page__form label .contact-page__optional { color: var(--freshomill-color-muted); font-weight: 400; }
  .contact-page__field { position: relative; display: flex; align-items: center; min-height: var(--freshomill-touch-target); }
  .contact-page__field > svg { position: absolute; left: 11px; z-index: 1; width: 16px; height: 16px; fill: none; stroke: var(--freshomill-color-ink); stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; pointer-events: none; }
  .contact-page__field input,.contact-page__field textarea { box-sizing: border-box; width: 100%; min-height: var(--freshomill-touch-target); padding: 7px 10px 7px 36px; border: 1px solid var(--freshomill-color-border); border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-surface); color: var(--freshomill-color-ink); font: inherit; font-size: var(--freshomill-font-size-body); line-height: 1.35; }
  .contact-page__field input::placeholder,.contact-page__field textarea::placeholder { color: var(--freshomill-color-muted); opacity: 1; }
  .contact-page__field input:focus,.contact-page__field textarea:focus { outline: 2px solid color-mix(in srgb, var(--freshomill-color-brand) 18%, transparent); border-color: var(--freshomill-color-brand); }
  .contact-page__field--textarea { align-items: flex-start; }
  .contact-page__field--textarea > svg { top: 10px; }
  .contact-page__field textarea { min-height: 66px; resize: vertical; }
  .contact-page__submit { display: flex; min-height: var(--freshomill-touch-target); align-items: center; justify-content: center; gap: 8px; margin-top: 6px; border: 1px solid var(--freshomill-color-brand-strong); border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-brand-strong); color: var(--freshomill-color-surface); font: inherit; font-size: var(--freshomill-font-size-body); font-weight: 700; cursor: pointer; transition: background-color .16s ease; }
  .contact-page__submit:hover { background: var(--freshomill-color-brand-hover); }
  .contact-page__submit:focus-visible,
  .contact-page a:focus-visible,
  .contact-page__notice-close:focus-visible { outline: 3px solid var(--freshomill-color-brand); outline-offset: 3px; }
  .contact-page__submit:disabled { opacity: .6; cursor: not-allowed; }
  .contact-page__submit svg { width: 15px; height: 15px; fill: currentColor; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.3; }
  .contact-page__notice { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 5px; padding: 9px 10px; border: 1px solid var(--freshomill-color-success-border); border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-success-soft); color: var(--freshomill-color-success); font-size: var(--freshomill-font-size-caption); line-height: 1.35; }
  .contact-page__notice--error { border-color: var(--freshomill-color-danger-border); background: var(--freshomill-color-danger-soft); color: var(--freshomill-color-danger); }
  .contact-page__notice-icon { display: grid; width: 18px; height: 18px; flex: 0 0 18px; place-items: center; border-radius: 50%; background: var(--freshomill-color-brand); color: var(--freshomill-color-surface); font-weight: 800; }
  .contact-page__notice strong { display: block; margin-bottom: 2px; }
  .contact-page__notice p { margin: 0; }
  .contact-page__notice-close { margin-inline-start: auto; padding: 0 2px; border: 0; background: transparent; color: inherit; font-size: 16px; line-height: 1; cursor: pointer; }
  .contact-page__details { display: grid; grid-template-rows: auto 1fr; gap: 12px; min-width: 0; }
  .contact-page__info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .contact-page__info-card { position: relative; display: flex; min-width: 0; min-height: 78px; align-items: flex-start; gap: 10px; overflow: hidden; padding: 10px; }
  .contact-page__info-card > div { position: relative; z-index: 1; min-width: 0; padding-top: 3px; }
  .contact-page__info-card h2 { margin-bottom: 5px; font-size: var(--freshomill-font-size-caption); }
  .contact-page__info-card p,.contact-page__info-card a { display: block; margin: 0; color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); line-height: 1.45; text-decoration: none; }
  .contact-page__info-card a:hover { color: var(--freshomill-color-brand); text-decoration: underline; }
  .contact-page__info-card .contact-page__muted { margin-top: 3px; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); }
  .contact-page__bottom-grid { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(190px, .9fr); gap: 10px; min-height: 0; }
  .contact-page__location-card,.contact-page__social-card { min-width: 0; padding: 10px; }
  .contact-page__location-card h2,.contact-page__social-card h2 { display: flex; align-items: center; gap: 7px; margin-bottom: 7px; }
  .contact-page__location-card h2 svg,.contact-page__social-card h2 svg { width: 16px; height: 16px; fill: none; stroke: var(--freshomill-color-ink); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
  .contact-page__location-card iframe { display: block; width: 100%; min-height: 170px; height: calc(100% - 24px); border: 0; border-radius: var(--freshomill-radius-card); background: var(--freshomill-color-brand-soft); }
  .contact-page__social-card h2 svg { stroke: var(--freshomill-color-brand); }
  .contact-page__social-card > p { margin: -3px 0 8px 23px; color: var(--freshomill-color-muted); font-size: var(--freshomill-font-size-caption); line-height: 1.35; }
  .contact-page__social-links { display: grid; gap: 6px; }
  .contact-page__social-item { display: flex; min-height: var(--freshomill-touch-target); align-items: center; gap: 9px; padding: 4px 8px; border-radius: var(--freshomill-radius-control); color: var(--freshomill-color-ink); font-size: var(--freshomill-font-size-caption); font-weight: 700; text-decoration: none; }
  a.contact-page__social-item:hover { filter: brightness(.97); }
  .contact-page__social-item > span:last-child { margin-inline-start: auto; font-size: 21px; font-weight: 400; line-height: 1; }
  .contact-page__social-item:nth-child(1) { background: #fff0f2; }
  .contact-page__social-item:nth-child(2) { background: #fff0ef; }
  .contact-page__social-item:nth-child(3) { background: #eaf4fc; }
  .contact-page__social-mark { display: grid; width: 23px; height: 23px; place-items: center; border-radius: var(--freshomill-radius-control); background: var(--freshomill-color-surface); font-size: 17px; font-weight: 800; }
  .contact-page__social-mark--instagram { color: #d62b7a; }
  .contact-page__social-mark--youtube { color: #e62117; font-size: var(--freshomill-font-size-small); }
  .contact-page__social-mark--linkedin { background: #0a66c2; color: var(--freshomill-color-surface); font-size: var(--freshomill-font-size-small); }
  @media screen and (max-width: 749px) {
    .contact-page__hero { aspect-ratio: 2.4 / 1; max-height: 180px; min-height: 150px; align-items: flex-start; }
    .contact-page__hero::after { background: linear-gradient(90deg, var(--freshomill-color-brand-soft) 0%, rgb(243 247 233 / .94) 44%, rgb(243 247 233 / .24) 100%); }
    .contact-page__hero-image { object-position: 72% center; }
    .contact-page__hero-inner { width: 100%; padding: var(--freshomill-space-3) var(--freshomill-page-gutter); }
    .contact-page__eyebrow { margin-bottom: 3px; font-size: var(--freshomill-font-size-caption); }
    .contact-page__hero h1 { max-width: 70%; font-size: clamp(18px, 5.2vw, 25px); line-height: .98; }
    .contact-page__intro { display: -webkit-box; max-width: 58%; margin-top: 6px; overflow: hidden; font-size: clamp(12px, 3.2vw, 14px); line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 4; }
    .contact-page__content { grid-template-columns: minmax(0, 1fr); gap: var(--freshomill-space-3); width: calc(100% - var(--freshomill-page-gutter) - var(--freshomill-page-gutter)); margin-top: var(--freshomill-space-3); margin-bottom: var(--freshomill-space-5); }
    .contact-page__form-card { padding: var(--freshomill-space-4); }
    .contact-page__form-heading { gap: var(--freshomill-space-2); margin-bottom: var(--freshomill-space-3); }
    .contact-page__icon { width: 30px; height: 30px; flex-basis: 30px; }
    .contact-page__icon--large { width: 34px; height: 34px; flex-basis: 34px; }
    .contact-page__icon svg { width: 17px; height: 17px; }
    .contact-page__form-heading h2 { font-size: var(--freshomill-font-size-body); }
    .contact-page__form-heading p { font-size: var(--freshomill-font-size-caption); }
    .contact-page__form { gap: var(--freshomill-space-2); }
    .contact-page__form label { font-size: var(--freshomill-font-size-caption); }
    .contact-page__field { min-height: var(--freshomill-touch-target); }
    .contact-page__field > svg { left: 8px; width: 13px; height: 13px; }
    .contact-page__field input,.contact-page__field textarea { min-height: var(--freshomill-touch-target); padding: 8px 9px 8px 30px; border-radius: var(--freshomill-radius-control); font-size: 16px; }
    .contact-page__field--textarea > svg { top: 8px; }
    .contact-page__field textarea { min-height: 64px; }
    .contact-page__submit { min-height: var(--freshomill-touch-target); margin-top: 5px; font-size: var(--freshomill-font-size-small); }
    .contact-page__submit svg { width: 13px; height: 13px; }
    .contact-page__notice { padding: 8px; font-size: var(--freshomill-font-size-caption); }
    .contact-page__notice-icon { width: 16px; height: 16px; flex-basis: 16px; }
    .contact-page__details { gap: var(--freshomill-space-3); }
    .contact-page__info-grid { gap: var(--freshomill-space-2); }
    .contact-page__info-card { min-height: 64px; gap: var(--freshomill-space-2); padding: var(--freshomill-space-2); border-radius: var(--freshomill-radius-card); }
    .contact-page__info-card h2 { margin-bottom: 3px; font-size: var(--freshomill-font-size-caption); }
    .contact-page__info-card p,.contact-page__info-card a { font-size: var(--freshomill-font-size-caption); line-height: 1.4; overflow-wrap: anywhere; }
    .contact-page__info-card .contact-page__muted { margin-top: 2px; font-size: var(--freshomill-font-size-caption); }
    .contact-page__bottom-grid { grid-template-columns: minmax(0, 1fr); gap: var(--freshomill-space-2); }
    .contact-page__location-card,.contact-page__social-card { padding: var(--freshomill-space-3); border-radius: var(--freshomill-radius-card); }
    .contact-page__location-card h2,.contact-page__social-card h2 { gap: 5px; margin-bottom: 6px; font-size: var(--freshomill-font-size-small); }
    .contact-page__location-card h2 svg,.contact-page__social-card h2 svg { width: 13px; height: 13px; }
    .contact-page__location-card iframe { height: 118px; min-height: 118px; }
    .contact-page__social-card > p { margin: 0 0 8px 18px; font-size: var(--freshomill-font-size-caption); }
    .contact-page__social-links { gap: 4px; }
    .contact-page__social-item { min-height: var(--freshomill-touch-target); gap: 7px; padding: 5px 7px; font-size: var(--freshomill-font-size-caption); }
    .contact-page__social-mark { width: 19px; height: 19px; font-size: var(--freshomill-font-size-body); }
    .contact-page__social-mark--youtube,.contact-page__social-mark--linkedin { font-size: var(--freshomill-font-size-caption); }
  }
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .contact-page__content { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
    .contact-page__info-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 389px) {
    .contact-page__info-grid { grid-template-columns: minmax(0, 1fr); }
  }
{% endstylesheet %}

