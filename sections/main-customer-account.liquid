ize: var(--freshomill-font-size-caption); }.customer-hub__button { min-height: var(--freshomill-touch-target); padding: 7px 10px; font-size: var(--freshomill-font-size-caption); }.customer-hub__card-heading--spread { display: grid; }.customer-hub__add-address { width: 100%; }.customer-hub__add-address summary { width: 100%; }.customer-hub__address { grid-template-columns: 20px minmax(0,1fr); gap: 7px; padding: 9px; }.customer-hub__address-actions { grid-column: 2; justify-content: flex-end; }.customer-hub__address-copy p { font-size: var(--freshomill-font-size-caption); }.customer-hub__address-copy small { font-size: var(--freshomill-font-size-caption); }.customer-hub__orders { gap: var(--freshomill-space-2); margin-top: 0; }.customer-hub__orders-heading { gap: 8px; }.customer-hub__order-filter select { min-width: 92px; font-size: var(--freshomill-font-size-caption); }.customer-hub__order { padding: 10px; }.customer-hub__order-top { gap: 6px; flex-wrap: wrap; }.customer-hub__order h3 { font-size: var(--freshomill-font-size-caption); }.customer-hub__order-top p { font-size: var(--freshomill-font-size-caption); }.customer-hub__order-total { min-width: 49px; padding-inline: 5px; }.customer-hub__order-total strong { font-size: var(--freshomill-font-size-caption); }.customer-hub__status { padding: 6px; font-size: var(--freshomill-font-size-caption); }.customer-hub__order-body { grid-template-columns: 1fr; gap: 10px; padding: 9px 0; }.customer-hub__order-products { gap: 5px; }.customer-hub__order-thumb,.customer-hub__order-extra { width: min(18vw,60px); }.customer-hub__timeline { gap: 4px; }.customer-hub__timeline span { font-size: var(--freshomill-font-size-caption); }.customer-hub__timeline b { font-size: var(--freshomill-font-size-caption); }.customer-hub__timeline small { font-size: var(--freshomill-font-size-caption); }.customer-hub__order-actions { display: grid; grid-template-columns: 1fr 1fr; }.customer-hub__order-actions .customer-hub__button { width: 100%; box-s